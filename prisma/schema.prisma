// ---------------------------------------------------------------------------
// Health module
// ---------------------------------------------------------------------------

model Participant {
  id                     String             @id @default(uuid())
  eventId                String             @map("event_id")
  // `name` is kept as the maintained full display name ("Jméno Příjmení",
  // written from firstName+lastName on every save) so existing readers
  // (search, sort, exports, {{Name}}) keep working unchanged -- see
  // src/lib/participant-name.ts. firstName/lastName are null for rows not
  // yet migrated (scripts/split-participant-names.ts) or left ambiguous.
  name                   String
  firstName              String?            @map("first_name")
  lastName               String?            @map("last_name")
  groupName              String?            @map("group_name")
  dateOfBirth            DateTime?          @map("date_of_birth") @db.Date
  active                 Boolean            @default(true)
  registrationStatus     RegistrationStatus @default(pending) @map("registration_status")
  // Admin-defined participant fields (address, health insurance, camp-fee
  // membership, etc.) -- Record<fieldKey, string>, keyed by
  // EventParticipantField.key. Not a fixed set of columns: which fields
  // exist, their type, and which screens show them are all admin-editable
  // (see ParticipantFieldTemplate/EventParticipantField below and
  // src/lib/document-variables.ts's participant_custom_field resolver).
  customFieldValues      Json?              @map("custom_field_values")
  // Camp-fee variable symbol -- assigned once, at acceptance (see
  // src/lib/document-variables.ts), stable afterwards. Null until accepted.
  registrationNumber     Int?               @map("registration_number")
  // The participant's own page /u/<token> (2026-10-23): details, documents and payment for one
  // registration when it isn't linked to a person in Členové (src/lib/participant-link.ts).
  detailsToken           String?            @unique @map("details_token")
  // Child or adult as registered (public form), for a participant without a person in Členové; null = by age.
  isAdult                Boolean?           @map("is_adult")
  // The persistent child profile this event's row belongs to (null = not
  // linked; everything works as before). See src/lib/children.ts.
  childId                String?            @map("child_id")
  // Optional note a parent typed when registering through the portal.
  portalNote             String?            @map("portal_note")
  // Price category key (Event.priceRules); null/unknown = the first category
  // allowed for the person. Unused while the event has no price rules.
  priceCategory          String?            @map("price_category")
  // The price the last acceptance e-mail carried -- the roster flags a live
  // price that differs from it ("cena se změnila po odeslání").
  acceptedPriceCzk       Int?               @map("accepted_price_czk")
  // The variable symbol the same acceptance e-mail carried -- the bank check
  // matches on it as well as on the current one.
  acceptedVariableSymbol String?            @map("accepted_variable_symbol")
  createdAt              DateTime           @default(now()) @map("created_at")

  event          Event                 @relation(fields: [eventId], references: [id])
  child          Child?                @relation(fields: [childId], references: [id])
  guardians      ParticipantGuardian[]
  incidents      Incident[]
  parentQuestions ParentQuestion[]
  mealAbsences    MealAbsence[]
  diet            ParticipantDiet?
  medPlans       ParticipantMedPlan[]
  medChecklist   MedChecklist[]
  emailLogs      ParentEmailLog[]
  documents      ParticipantDocument[]
  mailActionLogs MailActionLog[]
  bankMovements  BankMovement[]

  @@unique([eventId, registrationNumber])
  @@index([childId])
  @@map("participants")
}

// One child across all events and years: identity (name + birth date, what
// linking matches on) plus the profile (src/lib/child-profile.ts) -- the
// org-wide field values and guardians, copied once from the latest
// participation and pushed to upcoming connected events on every change.
model Child {
  id                    String         @id @default(uuid())
  name                  String
  firstName             String?        @map("first_name")
  lastName              String?        @map("last_name")
  dateOfBirth           DateTime?      @map("date_of_birth") @db.Date
  // Record<ParticipantFieldTemplate.key, string> -- same keys/values as
  // Participant.customFieldValues.
  fieldValues           Json?          @map("field_values")
  // Kuchyně (2026-10-28, adults): allergen codes (src/lib/kitchen/allergens.ts ALLERGENS), diet flags (DIET_FLAGS)
  // and a free note. The address stays in fieldValues (the organization's adresa_* fields).
  allergens             String[]       @default([])
  dietFlags             String[]       @default([]) @map("diet_flags")
  dietNote              String?        @map("diet_note")
  // Parent portal link (/p/<token>): random, generated on demand; replacing it
  // kills the old link and every device's birth-date cookie (src/lib/portal-gate.ts).
  portalToken           String?        @unique @map("portal_token")
  // Wrong birth-date attempts in the current one-hour window (throttle).
  portalGateFailures    Int            @default(0) @map("portal_gate_failures")
  portalGateWindowStart DateTime?      @map("portal_gate_window_start")
  // Slice 3 (docs/registration-slice3-spec.md A): members are people -- an
  // adult member (leader, supporter) is a Child row with isAdult on (the table
  // keeps its name, no destructive rename). An adult's own contact is their
  // first guardian row (same e-mail = same person in the family view).
  isAdult               Boolean        @default(false) @map("is_adult")
  // An adult from outside the organization (a hired cook, a helper): kept in Lidé for the events, never a member.
  external              Boolean        @default(false)
  // The household this person belongs to (at most one); null = none. Families
  // are only ever made by an admin's confirm (or the public form, flagged for review).
  familyId              String?        @map("family_id")
  // "Už nebude chodit" (docs/registration-slice8-spec.md #2): inactive since
  // leftAt (null = active), marked in the portal or by an admin. Nothing is
  // deleted; the portal won't register an inactive person and link e-mails skip them.
  leftAt                DateTime?      @map("left_at")
  leftNote              String?        @map("left_note")
  leftVia               PersonLeftVia? @map("left_via")
  createdAt             DateTime       @default(now()) @map("created_at")

  family       Family?          @relation(fields: [familyId], references: [id], onDelete: SetNull)
  participants Participant[]
  guardians    ChildGuardian[]
  changes      ChildChange[]
  emailLogs    ChildEmailLog[]
  documents    PersonDocument[]
  eventPersons EventPerson[]
  authors      Author[]
  vehicles     Vehicle[]

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([familyId])
  @@map("children")
}

enum PeopleLinkMode {
  all
  existing
}

enum PersonLeftVia {
  portal
  admin
}

// Attempts counted for the public pages' rate limits (slice 3 D/F): key =
// "submit:<hashed IP>" (public form), "resend:<participantId>" (portal
// re-send), "upload:<participantId>" (portal upload). Old rows are pruned.
model PortalRateHit {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("portal_rate_hits")
}

// A household (docs/registration-slice3-spec.md B), e.g. "Novákovi": one
// portal link /p/<portalToken> for every member. Same token + birth-date gate
// rules as a child's link (any member's birth date passes; the cookie is
// scoped to the family + current token, src/lib/portal-gate.ts).
model Family {
  id                    String    @id @default(uuid())
  name                  String
  portalToken           String?   @unique @map("portal_token")
  portalGateFailures    Int       @default(0) @map("portal_gate_failures")
  portalGateWindowStart DateTime? @map("portal_gate_window_start")
  // Made by the public registration form: shown under "Ke kontrole" on the
  // Lidé page (possible duplicates are never merged automatically).
  needsReview           Boolean   @default(false) @map("needs_review")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  members Child[]

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("families")
}

// Mirrors ParticipantGuardian, on the child profile.
model ChildGuardian {
  id                     String  @id @default(uuid())
  childId                String  @map("child_id")
  name                   String?
  email                  String
  relationship           String?
  phone                  String?
  receivesCommunications Boolean @default(true) @map("receives_communications")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("child_guardians")
}

// Per org-wide field: what a parent may do with it in the portal. hidden (the
// default) = not even sent to the portal.
enum PortalAccess {
  edit
  approval
  read
  hidden
}

enum ChildChangeStatus {
  pending
  accepted
  rejected
}

// A parent's portal edit of an `approval` field, waiting for an admin. While
// pending the old value stays live everywhere. fieldKey = a
// ParticipantFieldTemplate key or a built-in (participant_first_name,
// participant_last_name, datum_narozeni). One pending row per child + field: a
// newer edit replaces it.
model ChildChange {
  id          String            @id @default(uuid())
  childId     String            @map("child_id")
  fieldKey    String            @map("field_key")
  oldValue    String?           @map("old_value")
  newValue    String?           @map("new_value")
  status      ChildChangeStatus @default(pending)
  createdAt   DateTime          @default(now()) @map("created_at")
  decidedById String?           @map("decided_by_id")
  decidedAt   DateTime?         @map("decided_at")

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("ChildChangeDecidedBy", fields: [decidedById], references: [id])

  @@index([childId, status])
  @@map("child_changes")
}

// Child-level e-mails (the portal link) -- ParentEmailLog needs a participant,
// these have none. One row per recipient attempt.
model ChildEmailLog {
  id           String            @id @default(uuid())
  childId      String            @map("child_id")
  email        String
  purposeKey   String            @map("purpose_key")
  sentAt       DateTime          @default(now()) @map("sent_at")
  status       ParentEmailStatus
  errorMessage String?           @map("error_message")
  // Null = sent on the parent's own request ("Zapomněl(a) jsem odkaz", src/lib/portal-recovery.ts).
  sentByUserId String?           @map("sent_by_user_id")
  subject      String?

  child  Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  sentBy User? @relation("ChildEmailSentBy", fields: [sentByUserId], references: [id])

  @@index([childId])
  @@map("child_email_log")
}

model ParticipantGuardian {
  id                     String  @id @default(uuid())
  participantId          String  @map("participant_id")
  name                   String?
  email                  String
  relationship           String?
  phone                  String?
  receivesCommunications Boolean @default(true) @map("receives_communications")

  participant Participant      @relation(fields: [participantId], references: [id])
  emailLogs   ParentEmailLog[]

  @@map("participant_guardians")
}

enum ParticipantFieldType {
  text
  number
  date
  boolean
  select
  image
  // Computed from other fields joined by a separator (e.g. full address);
  // options = { parts: fieldKey[], separator } -- never stored per participant.
  composite
}

// Deliberately distinct from ModuleKey -- "list" (the central Seznam
// účastníků roster) isn't an access-controlled module, it's a display
// surface within the roster. A genuinely new module gets a new surface
// value here the same way ModuleKey itself grows when a module ships.
// `documents` and `import` were folded in from the old standalone
// MergeVariable/"Include in documents" mechanism and the participant-import
// screen's hardcoded target list -- both are now just more surfaces a field
// can be flagged for, same UI as the display surfaces. They're a11y-neutral
// to module gating (see allowedParticipantFieldKeys) since a field can be
// document-mergeable regardless of which module it's otherwise scoped to.
enum ParticipantFieldSurface {
  list // Seznam účastníků (central roster) columns
  health_list // Zdraví page columns
  health_detail // Zdraví participant detail page fields
  mail_list // Mail participants page columns
  documents // usable as {{key}} in document merge
  email // usable as {{key}} in e-mail templates (split from documents)
  import // offered as a target column when importing participants
}

// Which participant-connected thing a field actually is. `custom` is the
// only kind ParticipantFieldTemplate ever holds (org-wide admin-defined
// fields); `builtin`/`guardian`/`computed` only ever exist as fixed,
// non-deletable EventParticipantField rows seeded per event (see
// src/lib/participant-field-seed.ts's seedFixedParticipantFields) so their
// surfaces are configurable from the same admin screen as custom fields,
// without a template layer that makes no sense for a field type can't add
// or remove.
enum ParticipantFieldKind {
  custom
  builtin
  guardian
  computed
}

// Only set when kind = computed -- which fixed formula resolves the value.
// A new computed type needs a code change in src/lib/document-variables.ts
// regardless (the formula itself can't be admin-authored), this just says
// which one a given fixed row maps to.
enum ComputedFieldType {
  effective_price
  variable_symbol
  payment_qr_image
  // First guardian with receivesCommunications = true, else the first
  // guardian -- see resolveContactEmail() in document-variables.ts.
  contact_email
  // Ano / Ne: a member for the event's membership year (isMember() in document-variables.ts).
  membership_status
  // The price category's name (Participant.priceCategory by the event's price rules).
  price_category
  // The detailed fields the event asks: "vyplněno" / "chybí N" (document-variables.ts).
  details_status
}

// Org-wide field definition, synced into EventParticipantField the same
// way CategoryTemplate syncs into EventCategory (see
// src/app/api/events/[id]/participant-fields/sync/route.ts). `key` is the
// stable {{key}} used both in customFieldValues and, once its `documents`
// surface is on, in document templates -- immutable after creation.
model ParticipantFieldTemplate {
  // Organizations step 4: id is the key; `key` is unique per organization (NULL = app level, one group).
  id                     String                    @id @default(uuid())
  key                    String
  label                  String
  fieldType              ParticipantFieldType      @map("field_type")
  options                Json?
  // A select's own options for adult members (e.g. Žena / Muž next to the children's Dívka / Chlapec);
  // null = the same as `options`. src/lib/registration-fields.ts optionsFor.
  adultOptions           Json?                     @map("adult_options")
  // Suggested surfaces applied when this template is synced into an event
  // (manually, at event creation, or when a module the surfaces belong to
  // gets enabled -- see .../participant-fields/sync/route.ts and the
  // modules PATCH route's enable hook).
  defaultSurfaces        ParticipantFieldSurface[] @map("default_surfaces")
  active                 Boolean                   @default(true)
  // Parent portal rule for this field (child profiles, docs/registration-portal-spec.md C).
  portalAccess           PortalAccess              @default(hidden) @map("portal_access")
  // Must be filled in the public registration form (slice 3 D); only for
  // fields the form shows (portalAccess != hidden).
  requiredInRegistration Boolean                   @default(false) @map("required_in_registration")
  // Slice 5 (docs/registration-slice5-spec.md 1): who the field applies to
  // (children / adult members / both) and whether the profile asks it up
  // front (basic) or only when an event needs it (detailed).
  audience               FieldAudience             @default(both)
  level                  FieldLevel                @default(basic)
  // Parent portal profile page (2026-10-22): the organization's own section the field sits in
  // (Organization.portalProfileSections key; null / unknown = by level), and whether it's on the
  // family overview next to the name and birth date.
  profileSection         String?                   @map("profile_section")
  portalSummary          Boolean                   @default(false) @map("portal_summary")
  // A column of the Členové list (2026-10-27).
  memberListColumn       Boolean                   @default(false) @map("member_list_column")
  // Order for parents (2026-10-23): the portal profile, the public form and the registration step
  // list fields by this (null = after the ordered ones, by label). Šablony -> Účastníci -> Pořadí polí.
  portalSortOrder        Int?                      @map("portal_sort_order")

  // Owner (docs/organizations-change-notes.md).
  organizationId   String?                    @map("organization_id")
  organization     Organization?              @relation(fields: [organizationId], references: [id])
  // The app template this one was copied from.
  sourceTemplateId String?                    @map("source_template_id")
  sourceTemplate   ParticipantFieldTemplate?  @relation("ParticipantFieldTemplateSource", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies           ParticipantFieldTemplate[] @relation("ParticipantFieldTemplateSource")

  // Per organization; NULL (app level) counts as one group: NULLS NOT DISTINCT in the migration SQL.
  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("participant_field_templates")
}

enum FieldAudience {
  both
  children
  adults
}

enum FieldLevel {
  basic
  detailed
}

model EventParticipantField {
  id                     String                    @id @default(uuid())
  eventId                String                    @map("event_id")
  key                    String
  label                  String
  fieldType              ParticipantFieldType      @map("field_type")
  options                Json?
  surfaces               ParticipantFieldSurface[]
  sortOrder              Int?                      @map("sort_order")
  active                 Boolean                   @default(true)
  isFromTemplate         Boolean                   @default(false) @map("is_from_template")
  // custom rows (the default) are fully admin-managed, same as before.
  // builtin/guardian/computed rows are fixed system rows seeded per event --
  // their key/fieldType/kind/computedType aren't editable, only surfaces/active.
  kind                   ParticipantFieldKind      @default(custom)
  computedType           ComputedFieldType?        @map("computed_type")
  // "Vyžadovat při přihlášce" (slice 5 #2): asked in the registration step. A
  // field with an org template only while parents may edit it (edit/approval);
  // an event-only field is an event question, stored on the participant only.
  requiredOnRegistration Boolean                   @default(false) @map("required_on_registration")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, key])
  @@map("event_participant_fields")
}

// Dospělí na akci (2026-10-28): an adult of Lidé (Child.isAdult) at the event -- a leader, helper, cook.
// Not a participant: no registration, no portal, no e-mail. Dates null = the event's.
model EventPerson {
  id        String    @id @default(uuid())
  eventId   String    @map("event_id")
  childId   String    @map("child_id")
  // Display only: vedoucí, pomocník, kuchař…
  label     String?
  // The days at the event ("YYYY-MM-DD"), any intervals; empty = the whole event (follows it if it moves).
  days      String[]  @default([])
  // Eats at the camp (the kitchen counts them).
  eats      Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  mealAbsences MealAbsence[]

  @@unique([eventId, childId])
  @@index([eventId])
  @@map("event_persons")
}

// "Dotazy na rodiče" (2026-10-27): a question for a participant's parents, noted before the event and
// answered when they bring the child -- free text or one of its predefined answers.
model ParentQuestion {
  id              String    @id @default(uuid())
  participantId   String    @map("participant_id")
  question        String
  // Predefined answers to click (string[]); Ano / Ne are always offered too.
  options         Json?
  answer          String?
  answeredAt      DateTime? @map("answered_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("parent_questions")
}

model Incident {
  id               String           @id @default(uuid())
  participantId    String           @map("participant_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  createdByUserId  String           @map("created_by_user_id")
  category         IncidentCategory
  templateType     String?          @map("template_type")
  incidentDate     DateTime         @default(now()) @map("incident_date") @db.Date
  incidentTime     String?          @map("incident_time")
  actionSummary    String           @map("action_summary")
  pillName         String?          @map("pill_name")
  details          String?
  photoGcsPath     String?          @map("photo_gcs_path")
  // Stored bytes in GCS (usage metering, /vyuziti); null = not measured yet (scripts/backfill-gcs-sizes.ts).
  sizeBytes        BigInt?          @map("size_bytes")
  parentIncidentId String?          @map("parent_incident_id")
  tempC            Decimal?         @map("temp_c") @db.Decimal(4, 1)
  bodyView         BodyView?        @map("body_view")
  bodyXPct         Decimal?         @map("body_x_pct") @db.Decimal(5, 2)
  bodyYPct         Decimal?         @map("body_y_pct") @db.Decimal(5, 2)
  // "Vyřešeno" (2026-10-29): a case (top-level incident, with its follow-ups) needs no more attention.
  // A status, not content: set / cleared directly, outside the IncidentUpdate correction history.
  resolvedAt       DateTime?        @map("resolved_at")
  resolvedByUserId String?          @map("resolved_by_user_id")
  // "Poznámka pro vedoucí" (2026-10-30): for the organizers only -- never in the parents' summary / PDF.
  internalNote     String?          @map("internal_note")

  participant    Participant      @relation(fields: [participantId], references: [id])
  createdBy      User             @relation("IncidentCreatedBy", fields: [createdByUserId], references: [id])
  parentIncident Incident?        @relation("IncidentFollowUp", fields: [parentIncidentId], references: [id])
  followUps      Incident[]       @relation("IncidentFollowUp")
  updates        IncidentUpdate[]

  @@map("incidents")
}

model IncidentUpdate {
  id              String             @id @default(uuid())
  incidentId      String             @map("incident_id")
  updatedAt       DateTime           @default(now()) @map("updated_at")
  updatedByUserId String             @map("updated_by_user_id")
  updateType      IncidentUpdateType @map("update_type")
  incidentDate    DateTime           @map("incident_date") @db.Date
  incidentTime    String?            @map("incident_time")
  actionSummary   String             @map("action_summary")
  pillName        String?            @map("pill_name")
  details         String?
  photoGcsPath    String?            @map("photo_gcs_path")
  // Stored bytes in GCS (usage metering, /vyuziti); null = not measured yet (scripts/backfill-gcs-sizes.ts).
  sizeBytes       BigInt?            @map("size_bytes")
  tempC           Decimal?           @map("temp_c") @db.Decimal(4, 1)
  bodyView        BodyView?          @map("body_view")
  bodyXPct        Decimal?           @map("body_x_pct") @db.Decimal(5, 2)
  bodyYPct        Decimal?           @map("body_y_pct") @db.Decimal(5, 2)
  note            String?

  incident  Incident @relation(fields: [incidentId], references: [id])
  updatedBy User     @relation("IncidentUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("incident_updates")
}

// Generic org-default -> per-event-copy template mechanism, shared by meds,
// meds time slots, and situation templates (see design doc "Build note").
model ListTemplate {
  id        String           @id @default(uuid())
  kind      ListTemplateKind
  key       String?
  name      String
  sortOrder Int?             @map("sort_order")
  active    Boolean          @default(true)
  data      Json?

  // Owner (docs/organizations-change-notes.md).
  organizationId   String?        @map("organization_id")
  organization     Organization?  @relation(fields: [organizationId], references: [id])
  // The template this one was copied from (organizations step 4); unused for now.
  sourceTemplateId String?        @map("source_template_id")
  sourceTemplate   ListTemplate?  @relation("ListTemplateSource", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies           ListTemplate[] @relation("ListTemplateSource")

  @@index([organizationId])
  @@map("list_templates")
}

model EventListItem {
  id             String           @id @default(uuid())
  eventId        String           @map("event_id")
  kind           ListTemplateKind
  key            String?
  name           String
  sortOrder      Int?             @map("sort_order")
  active         Boolean          @default(true)
  isFromTemplate Boolean          @default(false) @map("is_from_template")
  data           Json?

  event                    Event                 @relation(fields: [eventId], references: [id])
  medPlansAsMed            ParticipantMedPlan[]  @relation("MedPlanMed")
  medPlansAsSlot           ParticipantMedPlan[]  @relation("MedPlanSlot")
  checklistAsMed           MedChecklist[]        @relation("MedChecklistMed")
  checklistAsSlot          MedChecklist[]        @relation("MedChecklistSlot")
  documents                ParticipantDocument[] @relation("ParticipantDocumentType")
  planBlocksAsLeader       PlanBlock[]           @relation("PlanBlockLeader")
  planBlocksAsLocation     PlanBlock[]           @relation("PlanBlockLocation")
  planActivitiesAsLeader   PlanActivity[]        @relation("PlanActivityLeader")
  planActivitiesAsLocation PlanActivity[]        @relation("PlanActivityLocation")
  planEntriesAsSlot        PlanEntry[]           @relation("PlanEntrySlot")
  headcountAdjustsAsSlot   HeadcountAdjust[]     @relation("HeadcountAdjustSlot")
  mealAbsencesAsSlot       MealAbsence[]         @relation("MealAbsenceSlot")

  @@map("event_list_items")
}

model ParticipantMedPlan {
  id            String  @id @default(uuid())
  participantId String  @map("participant_id")
  eventMedId    String  @map("event_med_id")
  eventSlotId   String  @map("event_slot_id")
  dose          String?
  notes         String?
  active        Boolean @default(true)

  participant Participant   @relation(fields: [participantId], references: [id])
  eventMed    EventListItem @relation("MedPlanMed", fields: [eventMedId], references: [id])
  eventSlot   EventListItem @relation("MedPlanSlot", fields: [eventSlotId], references: [id])

  @@map("participant_med_plans")
}

model MedChecklist {
  id            String    @id @default(uuid())
  participantId String    @map("participant_id")
  eventMedId    String    @map("event_med_id")
  eventSlotId   String    @map("event_slot_id")
  date          DateTime  @db.Date
  given         Boolean   @default(false)
  givenAt       DateTime? @map("given_at")
  givenByUserId String?   @map("given_by_user_id")

  participant Participant   @relation(fields: [participantId], references: [id])
  eventMed    EventListItem @relation("MedChecklistMed", fields: [eventMedId], references: [id])
  eventSlot   EventListItem @relation("MedChecklistSlot", fields: [eventSlotId], references: [id])
  givenBy     User?         @relation("MedChecklistGivenBy", fields: [givenByUserId], references: [id])

  @@unique([participantId, eventMedId, eventSlotId, date])
  @@map("med_checklist")
}

model EmailTemplate {
  id         String  @id @default(uuid())
  purposeKey String  @map("purpose_key")
  // Own templates (purposeKey "custom_…", e.g. "Pozvánka na akci"): the name shown in Poslat e-mail.
  name       String?
  subject    String
  body       String
  active     Boolean @default(true)

  // Owner (docs/organizations-change-notes.md).
  organizationId   String?         @map("organization_id")
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  // The template this one was copied from (organizations step 4); unused for now.
  sourceTemplateId String?         @map("source_template_id")
  sourceTemplate   EmailTemplate?  @relation("EmailTemplateSource", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies           EmailTemplate[] @relation("EmailTemplateSource")

  // Per organization; NULL (app level) counts as one group: NULLS NOT DISTINCT in the migration SQL.
  @@unique([organizationId, purposeKey])
  @@index([organizationId])
  @@map("email_templates")
}

model EventEmailTemplate {
  id             String  @id @default(uuid())
  eventId        String  @map("event_id")
  purposeKey     String  @map("purpose_key")
  // Set for an own template of this event only (no organization template behind it).
  name           String?
  subject        String
  body           String
  isFromTemplate Boolean @default(false) @map("is_from_template")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, purposeKey])
  @@map("event_email_templates")
}

// A Workspace mailbox that its own owner has connected via OAuth consent
// (gmail.send scope only) -- the fallback to domain-wide delegation, which
// was rejected by the Workspace admin. Keyed by email, not event, so the
// same connected mailbox can be reused across multiple events without
// reconnecting; Event.senderEmail just points at one of these by address.
model MailSenderAccount {
  id                    String   @id @default(uuid())
  email                 String   @unique
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  scope                 String?  @map("scope")
  connectedByUserId     String   @map("connected_by_user_id")
  connectedAt           DateTime @default(now()) @map("connected_at")

  connectedByUser User @relation("MailAccountConnectedBy", fields: [connectedByUserId], references: [id])

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("mail_sender_accounts")
}

// A user's own connected Google account (OAuth). Each user can have at most one
// (unique connected_by_user_id -- reconnecting replaces their own row, never
// someone else's). An event uses the account of the user who configured its
// Drive (Event.driveConfiguredByUserId) for ALL Drive/Sheets/Docs work, including
// background jobs; without a valid connection it falls back to the service
// account (src/lib/drive.ts getDriveIdentity). `tokenInvalidAt` is set when
// Google reports the refresh token dead (revoked/expired) and cleared on reconnect.
model DriveAccount {
  id                    String    @id @default(uuid())
  email                 String    @unique
  refreshTokenEncrypted String    @map("refresh_token_encrypted")
  scope                 String?
  connectedByUserId     String    @unique @map("connected_by_user_id")
  connectedAt           DateTime  @default(now()) @map("connected_at")
  tokenInvalidAt        DateTime? @map("token_invalid_at")

  connectedByUser User @relation("DriveAccountConnectedBy", fields: [connectedByUserId], references: [id])

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("drive_accounts")
}

model ParentEmailLog {
  id            String            @id @default(uuid())
  participantId String            @map("participant_id")
  guardianId    String            @map("guardian_id")
  purposeKey    String            @map("purpose_key")
  sentAt        DateTime          @default(now()) @map("sent_at")
  status        ParentEmailStatus
  errorMessage  String?           @map("error_message")
  sentByUserId  String            @map("sent_by_user_id")
  pdfGcsPath    String?           @map("pdf_gcs_path")
  // Stored bytes in GCS (usage metering, /vyuziti); null = not measured yet (scripts/backfill-gcs-sizes.ts).
  sizeBytes     BigInt?           @map("size_bytes")
  // Resolved subject at send time (Part 7 of the participants/settings prompt: the sent-
  // mail log gets a "Předmět" column) -- null for rows sent before this column existed.
  subject       String?

  participant Participant         @relation(fields: [participantId], references: [id])
  guardian    ParticipantGuardian @relation(fields: [guardianId], references: [id])
  sentBy      User                @relation("ParentEmailSentBy", fields: [sentByUserId], references: [id])

  @@map("parent_email_log")
}

// The received-document record for Mail Helper. Row existence = received;
// no row = missing. GCS is the source of truth; drive_file_id/drive_synced_at
// are set once the one-way nightly/on-demand mirror sync runs (see design doc).
enum DocReviewStatus {
  pending
  approved
  rejected
}

model ParticipantDocument {
  id                   String             @id @default(uuid())
  participantId        String             @map("participant_id")
  eventListItemId      String             @map("event_list_item_id")
  gcsPath              String?            @map("gcs_path")
  // Stored bytes in GCS (usage metering, /vyuziti); null = not measured yet (scripts/backfill-gcs-sizes.ts).
  sizeBytes            BigInt?            @map("size_bytes")
  contentHash          String?            @map("content_hash")
  originalFilename     String?            @map("original_filename")
  driveFileId          String?            @map("drive_file_id")
  driveSyncedAt        DateTime?          @map("drive_synced_at")
  receivedVia          MailDocReceivedVia @map("received_via")
  sourceEmailMessageId String?            @map("source_email_message_id")
  receivedAt           DateTime           @default(now()) @map("received_at")
  // Null only for a parent's portal upload (receivedVia = portal).
  receivedByUserId     String?            @map("received_by_user_id")
  // Portal uploads wait for an admin (docs/registration-slice4-spec.md 6):
  // pending / rejected ones don't count as received anywhere (see
  // src/lib/registration-status.ts RECEIVED_WHERE). Null = not a portal
  // upload, counts as before.
  reviewStatus         DocReviewStatus?   @map("review_status")
  reviewNote           String?            @map("review_note")
  reviewedByUserId     String?            @map("reviewed_by_user_id")
  reviewedAt           DateTime?          @map("reviewed_at")

  participant    Participant   @relation(fields: [participantId], references: [id])
  eventListItem  EventListItem @relation("ParticipantDocumentType", fields: [eventListItemId], references: [id])
  receivedByUser User?         @relation("ParticipantDocumentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser User?         @relation("ParticipantDocumentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  bankMovement   BankMovement?

  @@map("participant_documents")
}

// A document that stays valid for years (docs/registration-slice6-spec.md 2),
// stored once on the person: the org document-type template is marked
// "platí trvale" (ListTemplate.data.permanent) and every event document type
// with the same key counts it as received (src/lib/person-documents.ts).
// History is kept -- the current one is the newest row not revoked. Only a
// real file becomes one (never a tick, never a generated document); the file
// is a copy under people/<childId>/documents/, so deleting the participant it
// came from doesn't take it along.
model PersonDocument {
  id                          String    @id @default(uuid())
  childId                     String    @map("child_id")
  // The template key (ListTemplate.key = EventListItem.key).
  docKey                      String    @map("doc_key")
  gcsPath                     String    @map("gcs_path")
  // Stored bytes in GCS (usage metering, /vyuziti); null = not measured yet (scripts/backfill-gcs-sizes.ts).
  sizeBytes                   BigInt?   @map("size_bytes")
  contentHash                 String    @map("content_hash")
  originalFilename            String?   @map("original_filename")
  // Where it came from: the participant document (plain id -- that row goes
  // when its participant is deleted) and its event. Both null = uploaded on the person page.
  sourceParticipantDocumentId String?   @map("source_participant_document_id")
  sourceEventId               String?   @map("source_event_id")
  createdAt                   DateTime  @default(now()) @map("created_at")
  createdByUserId             String?   @map("created_by_user_id")
  // "Neplatí": every event counts it as missing again (live, not snapshotted).
  revokedAt                   DateTime? @map("revoked_at")
  revokedByUserId             String?   @map("revoked_by_user_id")

  child         Child  @relation(fields: [childId], references: [id])
  sourceEvent   Event? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  createdByUser User?  @relation("PersonDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  revokedByUser User?  @relation("PersonDocumentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([childId, docKey])
  @@map("person_documents")
}

// Everything Mail Helper does that isn't a sent email (which stays in
// ParentEmailLog with its own purpose keys) -- bulk move/delete, attachment
// saves. See design doc "Logging -- split across two tables, not one".
model MailActionLog {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  eventId       String           @map("event_id")
  action        MailActionType
  messageId     String?          @map("message_id")
  participantId String?          @map("participant_id")
  subject       String?
  status        MailActionStatus
  details       String?
  createdAt     DateTime         @default(now()) @map("created_at")

  user        User         @relation("MailActionLogUser", fields: [userId], references: [id])
  event       Event        @relation(fields: [eventId], references: [id])
  participant Participant? @relation(fields: [participantId], references: [id])

  @@map("mail_action_logs")
}

// ---------------------------------------------------------------------------
// Planning Helper -- see docs/planning-helper-module-design.md. Slot start/end
// times are never stored: they're computed from the window start plus the
// durations of the preceding slots (src/lib/planning-engine.ts). Categories,
// locations and leaders are EventListItem rows (kinds plan_*).

enum PlanWindowKind {
  flexible // capacity enforced: shows free/overflow
  partial // slots allowed, capacity not enforced (e.g. evening program)
  fixed // locked, holds no slots (e.g. lunch)
}

model PlanDay {
  id        String    @id @default(uuid())
  eventId   String    @map("event_id")
  date      DateTime? @db.Date
  label     String
  theme     String?
  notes     String?
  sortOrder Int       @map("sort_order")

  event   Event        @relation(fields: [eventId], references: [id])
  windows PlanWindow[]

  @@index([eventId])
  @@map("plan_days")
}

model PlanWindow {
  id        String         @id @default(uuid())
  dayId     String         @map("day_id")
  name      String
  startMin  Int            @map("start_min") // minutes from midnight
  endMin    Int            @map("end_min")
  kind      PlanWindowKind @default(flexible)
  color     String?
  notes     String?
  sortOrder Int            @map("sort_order")

  day   PlanDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  slots PlanSlot[]

  @@index([dayId])
  @@map("plan_windows")
}

model PlanSlot {
  id          String  @id @default(uuid())
  windowId    String  @map("window_id")
  durationMin Int     @map("duration_min")
  position    Int
  notes       String?

  window PlanWindow  @relation(fields: [windowId], references: [id], onDelete: Cascade)
  blocks PlanBlock[]

  @@index([windowId])
  @@map("plan_slots")
}

// One branch of a slot; a slot with 2+ blocks is a parallel slot. Fields are a
// snapshot taken from the activity at creation, so later library edits don't
// rewrite existing plans.
model PlanBlock {
  id          String   @id @default(uuid())
  slotId      String   @map("slot_id")
  branchOrder Int      @map("branch_order")
  activityId  String?  @map("activity_id")
  customName  String?  @map("custom_name")
  description String?
  // [{categoryId, minutes|null}] -- main and secondary categories (EventListItem
  // plan_category ids), optional minute split; see categoryMinutes() in
  // planning-engine.ts. JSON rather than a join table: copied wholesale by
  // every move/copy, and unknown ids (a deleted category) are simply ignored.
  categories  Json     @default("[]")
  leaderId    String?  @map("leader_id")
  locationId  String?  @map("location_id")
  notes       String?
  // Participant groups this branch is for -- values of Participant.groupName
  // (plain names, no group table; see planning design doc, decision 5). Empty =
  // everyone.
  groupNames  String[] @default([]) @map("group_names")

  slot     PlanSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  activity PlanActivity?  @relation(fields: [activityId], references: [id], onDelete: SetNull)
  leader   EventListItem? @relation("PlanBlockLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  location EventListItem? @relation("PlanBlockLocation", fields: [locationId], references: [id], onDelete: SetNull)

  @@index([slotId])
  @@map("plan_blocks")
}

model PlanActivity {
  id                 String  @id @default(uuid())
  eventId            String  @map("event_id")
  name               String
  defaultDurationMin Int     @map("default_duration_min")
  description        String?
  categories         Json    @default("[]") // same shape as PlanBlock.categories
  defaultLeaderId    String? @map("default_leader_id")
  defaultLocationId  String? @map("default_location_id")
  energyLevel        String? @map("energy_level")
  repeatable         Boolean @default(false)
  active             Boolean @default(true)
  // Set when created from an org base-library ListTemplate (plan_activity), so
  // dragging the same base item again reuses this row instead of duplicating it.
  sourceTemplateId   String? @map("source_template_id")

  event           Event          @relation(fields: [eventId], references: [id])
  defaultLeader   EventListItem? @relation("PlanActivityLeader", fields: [defaultLeaderId], references: [id], onDelete: SetNull)
  defaultLocation EventListItem? @relation("PlanActivityLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)
  blocks          PlanBlock[]

  @@index([eventId])
  @@map("plan_activities")
}

// Hostnames other than the admin app that serve only the public registration
// page and/or the parent portal (docs/custom-domain.md). Data, not env vars, so
// a new domain needs no deploy. organizationId can join later, once there are organizations.
enum PublicHostPurpose {
  registration
  portal
  both
}

model PublicHost {
  id              String            @id @default(uuid())
  // Lowercase, no scheme, no port.
  hostname        String            @unique
  purpose         PublicHostPurpose
  // Registration hosts only: tied to one event; null = every event. The API keeps it null for portal/both.
  eventId         String?           @map("event_id")
  // At most one active default per purpose (checked in the API).
  isDefault       Boolean           @default(false) @map("is_default")
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now()) @map("created_at")
  createdByUserId String?           @map("created_by_user_id")
  // Websites allowed to frame /r and /p of this host (CSP frame-ancestors, src/proxy.ts):
  // normalized origins "https://host[:port]" (docs/custom-domain.md "Embedding").
  embedOrigins    String[]          @default([]) @map("embed_origins")
  // Portal hosts: the organization's web page embedding the portal; portal links in
  // e-mails become <embedPageUrl>#t=<token>. Its origin must be in embedOrigins.
  embedPageUrl    String?           @map("embed_page_url")

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([eventId])
  @@map("public_hosts")
}

// One scout group / organisation. Every org-level table points here
// (docs/organizations-change-notes.md); existing data belongs to "Pionýrská skupina Záře".
model Organization {
  id                      String   @id @default(uuid())
  ingredients             Ingredient[]
  meals                   Meal[]
  name                    String
  shortName               String   @map("short_name")
  contactEmail            String?  @map("contact_email")
  // Parent portal "Zapomněl(a) jsem odkaz" (2026-10-23): the mailbox it sends from (a connected
  // MailSenderAccount; null = the feature is off), and whether a new link replaces the old one.
  portalRecoverySenderEmail String? @map("portal_recovery_sender_email")
  // Uploaded files every e-mail of a kind carries (Šablony -> E-maily): { purposeKey: EmailFile[] } (src/lib/email-files.ts).
  emailFiles                Json?   @map("email_files")
  // The participant export's default columns (field keys, in order); an event may have its own.
  exportColumns             Json?   @map("export_columns")
  // "Cenová kategorie" on the portal profile (Šablony -> Pořadí polí pro rodiče): { show, section, order }
  // (src/lib/portal-rules.ts readProfileCategory); null = not shown.
  profileCategory           Json?   @map("profile_category")
  portalRecoveryNewLink   Boolean  @default(false) @map("portal_recovery_new_link")
  // "Ještě nejsem členem" next to it: an event's public registration, or any web address.
  portalJoinEventId       String?  @map("portal_join_event_id")
  portalJoinUrl           String?  @map("portal_join_url")
  active                  Boolean  @default(true)
  // Look of the public pages (/r, /p, landing; docs/custom-domain.md "Appearance"). Null = today's look.
  publicFontFamily        String?  @map("public_font_family")
  publicHeadingFontFamily String?  @map("public_heading_font_family")
  publicBaseFontSize      Int?     @map("public_base_font_size")
  // compact | normal | large
  publicHeadingScale      String?  @map("public_heading_scale")
  // compact | normal | relaxed
  publicLineHeight        String?  @map("public_line_height")
  // light | dark | null (= the visitor's system setting); ?theme= on the URL still wins.
  publicTheme             String?  @map("public_theme")
  // true = no page / card background: the embedding website's shows through.
  publicTransparent       Boolean  @default(false) @map("public_transparent")
  // Content width in px; 0 = the full width (100 %); null = today's (form 672 / 896 px, portal 896 px).
  publicContentWidth      Int?     @map("public_content_width")
  // The columns above = the base (the parent portal). Partial layers on top (src/lib/public-appearance.ts
  // pageAppearance): pages embedded with ?embed=1, and the standalone Veřejná přihláška page.
  appearanceEmbed         Json?    @map("appearance_embed")
  appearanceRegistration  Json?    @map("appearance_registration")
  // The parent portal profile's own sections after Základní / Podrobné údaje: [{ key, label }] in order
  // (src/lib/portal-rules.ts readProfileSections), e.g. health details, educational notes.
  portalProfileSections   Json?    @map("portal_profile_sections")
  // Own wording of the public registration form and parent portal texts ({ "public.doneTitle": "…" }),
  // over the translations (src/lib/public-texts.ts); an event's own (Event.publicTexts) wins on its page.
  publicTexts             Json?    @map("public_texts")
  // Cestovní příkazy (2026-11-03): printed on the order ("IČ: …", "V <city> dne").
  address                 String?
  ico                     String?
  city                    String?
  createdAt               DateTime @default(now()) @map("created_at")

  users                     User[]
  travelRateSets            TravelRateSet[]
  vehicles                  Vehicle[]
  travelOrders              TravelOrder[]
  knownDistances            KnownDistance[]
  travelTemplates           TravelTemplate[]
  events                    Event[]
  authors                   Author[]
  children                  Child[]
  families                  Family[]
  driveAccounts             DriveAccount[]
  mailSenderAccounts        MailSenderAccount[]
  publicHosts               PublicHost[]
  merchantAliases           MerchantAlias[]
  categoryTemplates         CategoryTemplate[]
  listTemplates             ListTemplate[]
  emailTemplates            EmailTemplate[]
  participantFieldTemplates ParticipantFieldTemplate[]
  bankAccounts              BankAccount[]

  @@map("organizations")
}

// Fio account watched for incoming payments (docs/bank-payments-design.md).
// The read-only API token is encrypted (src/lib/bank/token-crypto.ts) and
// never returned by any API.
enum BankProvider {
  fio
}

model BankAccount {
  id               String         @id @default(uuid())
  organizationId   String         @map("organization_id")
  label            String
  accountNumber    String         @map("account_number")
  bankCode         String         @map("bank_code")
  provider         BankProvider   @default(fio)
  tokenEncrypted   String?        @map("token_encrypted")
  tokenSetAt       DateTime?      @map("token_set_at")
  tokenSetByUserId String?        @map("token_set_by_user_id")
  lastCheckedAt    DateTime?      @map("last_checked_at")
  lastSuccessAt    DateTime?      @map("last_success_at")
  // Short code (src/lib/bank/fio-client.ts FioError), never a message or URL.
  lastError        String?        @map("last_error")
  active           Boolean        @default(true)
  // Banka (docs/bank-reconciliation.md). The registration payment check uses the same account and
  // token (one Fio token, one 30 s throttle: lastCheckedAt).
  sourceType       BankSourceType @default(fio_api) @map("source_type")
  // Audit 2026-11-05: "organization" (null = the same) or "personal" -- a person's own account; linking a
  // personal account to events is allowed but warned about (Připojení, Banka -> Účty a import).
  kind             String?
  iban             String?
  currency         String         @default("CZK")
  sheetId          String?        @map("sheet_id")
  sheetRange       String?        @map("sheet_range")
  columnMapping    Json?          @map("column_mapping")
  lastSyncAt       DateTime?      @map("last_sync_at")
  lastSyncResult   Json?          @map("last_sync_result")
  createdById      String?        @map("created_by_id")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  organization  Organization       @relation(fields: [organizationId], references: [id])
  tokenSetBy    User?              @relation("BankAccountTokenSetBy", fields: [tokenSetByUserId], references: [id], onDelete: SetNull)
  events        Event[]
  movements     BankMovement[]
  eventLinks    EventBankAccount[]
  transactions  BankTransaction[]
  importBatches BankImportBatch[]

  @@unique([organizationId, accountNumber, bankCode])
  @@map("bank_accounts")
}

enum BankMovementStatus {
  settled
  review
  ignored
}

model BankMovement {
  id                    String             @id @default(uuid())
  bankAccountId         String             @map("bank_account_id")
  // Fio's movement id (column22).
  movementId            String             @map("movement_id")
  bookedAt              DateTime           @map("booked_at") @db.Date
  amount                Decimal            @db.Decimal(14, 2)
  currency              String
  // Digits only, no leading zeros.
  variableSymbol        String?            @map("variable_symbol")
  counterName           String?            @map("counter_name")
  counterAccount        String?            @map("counter_account")
  message               String?
  status                BankMovementStatus
  // underpaid | overpaid | no_match | ambiguous | duplicate | not_czk
  reason                String?
  participantId         String?            @map("participant_id")
  participantDocumentId String?            @unique @map("participant_document_id")
  // A ticket order this payment settled (public events) instead of a participant.
  ticketOrderId         String?            @map("ticket_order_id")
  decidedByUserId       String?            @map("decided_by_user_id")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  bankAccount         BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  participant         Participant?         @relation(fields: [participantId], references: [id], onDelete: SetNull)
  participantDocument ParticipantDocument? @relation(fields: [participantDocumentId], references: [id], onDelete: SetNull)
  ticketOrder         TicketOrder?         @relation(fields: [ticketOrderId], references: [id], onDelete: SetNull)
  decidedBy           User?                @relation("BankMovementDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([bankAccountId, movementId])
  @@index([participantId])
  @@index([ticketOrderId])
  @@map("bank_movements")
}

// Money the organization sent to the event ("záloha") -- Rozpočet -> Zálohy; the settlement
// compares it with what the event paid in cash (docs/organizations-change-notes.md "Settlement").
model EventDeposit {
  id              String   @id @default(uuid())
  eventId         String   @map("event_id")
  amountCzk       Decimal  @map("amount_czk") @db.Decimal(14, 2)
  receivedAt      DateTime @map("received_at") @db.Date
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_deposits")
}

// Rozpočet -> Příjmy: the event's income lines (participant fees, the organization's subsidy, grants,
// sponsors...), each planned and real, so the budget shows a planned and a real result. Bills module.
model EventIncome {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  name       String
  plannedCzk Decimal? @map("planned_czk") @db.Decimal(14, 2)
  actualCzk  Decimal? @map("actual_czk") @db.Decimal(14, 2)
  note       String?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_incomes")
}

// Usage metrics (/vyuziti, super-admin only): one row per page a signed-in user opened.
// route = the route pattern (/events/[id]/bills), never raw ids. Kept 12 months (exchange-rates cron).
model UserActivity {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  eventId        String?  @map("event_id")
  module         String?
  route          String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@map("user_activity")
}

// One Gemini call (src/lib/ai-usage.ts) -- every attempt, failures too. Organization via the event.
// costUsd frozen at write time from AppSetting "gcpPrices"; null = price not set then.
model AiUsage {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  // Plain id, no relation: the cost stays after the bill is merged / deleted.
  billId         String?  @map("bill_id")
  userId         String?  @map("user_id")
  purpose        String
  model          String
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  thinkingTokens Int      @default(0) @map("thinking_tokens")
  costUsd        Decimal? @map("cost_usd") @db.Decimal(12, 6)
  success        Boolean
  createdAt      DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

// App-wide settings (super-admin), key -> JSON. "gcpPrices": src/lib/ai-usage.ts.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ---- Banka: bank reconciliation (docs/bank-reconciliation.md) ----

enum BankSourceType {
  fio_api
  sheet
  file
}

enum BankClassification {
  expense
  income
  cash
  transfer
  fee
  private
  other_event
}

enum BankIncomeType {
  fee
  grant
  donation
  refund
  other
}

enum BankMatchMethod {
  suggested
  manual
}

enum BankMatchTier {
  sure
  possible
}

enum BankDifferenceReason {
  fx
  fee
  rounding
  partial
}

enum BankImportSource {
  fio
  sheet
  csv
  xlsx
  paste
  gpc
  camt
}

enum BillPaymentChannel {
  cash
  other_account
}

// Which accounts an event reconciles, and the date window (default: the event's dates).
model EventBankAccount {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  bankAccountId String   @map("bank_account_id")
  dateFrom      DateTime @map("date_from") @db.Date
  dateTo        DateTime @map("date_to") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([eventId, bankAccountId])
  @@map("event_bank_accounts")
}

// One movement on the account, in one event. amount is signed (minus = outgoing).
model BankTransaction {
  id                    String             @id @default(uuid())
  bankAccountId         String             @map("bank_account_id")
  eventId               String             @map("event_id")
  // fio:<ID pohybu> | CAMT AcctSvcrRef | h:<sha256> (src/lib/bank/parse.ts)
  externalId            String             @map("external_id")
  bookingDate           DateTime           @map("booking_date") @db.Date
  valueDate             DateTime?          @map("value_date") @db.Date
  amount                Decimal            @db.Decimal(14, 2)
  currency              String             @default("CZK")
  originalAmount        Decimal?           @map("original_amount") @db.Decimal(14, 2)
  originalCurrency      String?            @map("original_currency")
  counterpartyAccount   String?            @map("counterparty_account")
  counterpartyBankCode  String?            @map("counterparty_bank_code")
  counterpartyName      String?            @map("counterparty_name")
  vs                    String?
  ks                    String?
  ss                    String?
  message               String?
  note                  String?
  bankType              String?            @map("bank_type")
  classification        BankClassification
  // false = still the automatic classification (import never overwrites a user's choice).
  classifiedByUser      Boolean            @default(false) @map("classified_by_user")
  incomeType            BankIncomeType?    @map("income_type")
  personAuthorId        String?            @map("person_author_id")
  // Reimbursement hint: the counterparty is this payer (src/lib/bank/suggest.ts).
  reimbursementAuthorId String?            @map("reimbursement_author_id")
  noDocumentNeeded      Boolean            @default(false) @map("no_document_needed")
  userNote              String?            @map("user_note")
  // No longer in the source (Google Sheet); never deleted automatically.
  sourceMissing         Boolean            @default(false) @map("source_missing")
  importBatchId         String?            @map("import_batch_id")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at")

  bankAccount BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  importBatch BankImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  matches     BankMatch[]

  @@unique([bankAccountId, externalId])
  @@index([eventId, bookingDate])
  @@index([eventId, classification])
  @@map("bank_transactions")
}

// A transaction <-> bill pairing. method suggested + confirmedAt null = only a suggestion (counts nowhere).
model BankMatch {
  id               String                @id @default(uuid())
  transactionId    String                @map("transaction_id")
  billId           String                @map("bill_id")
  amountCzk        Decimal               @map("amount_czk") @db.Decimal(14, 2)
  // The same allocation in the TRANSACTION's currency (a PLN account: PLN). amountCzk is the bill's
  // side at the ČNB rate (budgets, Platba state); amountTx says how much of the payment is used.
  // null (older rows) = amountCzk.
  amountTx         Decimal?              @map("amount_tx") @db.Decimal(14, 2)
  method           BankMatchMethod
  tier             BankMatchTier?
  score            Int                   @default(0)
  reasons          Json                  @default("[]")
  differenceReason BankDifferenceReason? @map("difference_reason")
  // This pairing marked the bill Proplaceno (unpairing offers to clear it).
  setPaidToAuthor  Boolean               @default(false) @map("set_paid_to_author")
  confirmedById    String?               @map("confirmed_by_id")
  confirmedAt      DateTime?             @map("confirmed_at")
  rejectedById     String?               @map("rejected_by_id")
  rejectedAt       DateTime?             @map("rejected_at")
  createdAt        DateTime              @default(now()) @map("created_at")

  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  bill        Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([transactionId, billId])
  @@index([billId])
  @@map("bank_matches")
}

model BankImportBatch {
  id            String           @id @default(uuid())
  bankAccountId String           @map("bank_account_id")
  eventId       String           @map("event_id")
  source        BankImportSource
  fileName      String?          @map("file_name")
  counts        Json
  // Per-row result table (src/lib/bank/import.ts).
  rows          Json
  userId        String?          @map("user_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([eventId, createdAt])
  @@map("bank_import_batches")
}

// "Není duplicita": two bills a person confirmed are different receipts (src/lib/bill-duplicates.ts).
// billAId < billBId; deleted with either bill.
model BillDuplicateDismissal {
  id        String   @id @default(uuid())
  billAId   String   @map("bill_a_id")
  billBId   String   @map("bill_b_id")
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  billA Bill @relation("DupDismissA", fields: [billAId], references: [id], onDelete: Cascade)
  billB Bill @relation("DupDismissB", fields: [billBId], references: [id], onDelete: Cascade)

  @@unique([billAId, billBId])
  @@index([billBId])
  @@map("bill_duplicate_dismissals")
}

enum TicketOrderStatus {
  pending
  paid
  cancelled
}

// Veřejná akce (docs/public-event-tickets-spec.md): one purchase -- a buyer, no person / family.
model TicketOrder {
  id             String            @id @default(uuid())
  eventId        String            @map("event_id")
  // 1, 2, 3 ... per event: the order number people see, and the end of the variable symbol.
  number         Int
  variableSymbol String            @map("variable_symbol")
  buyerName      String            @map("buyer_name")
  email          String
  phone          String?
  // [{ key, label, priceCzk, count }] as bought (prices frozen at order time).
  items          Json
  totalCzk       Int               @map("total_czk")
  status         TicketOrderStatus @default(pending)
  // public | portal
  source         String
  // Status link for the buyer (confirmation screen "Zkontrolovat platbu").
  publicToken    String            @unique @map("public_token")
  paidAt         DateTime?         @map("paid_at")
  // bank | manual
  paidVia        String?           @map("paid_via")
  paidByUserId   String?           @map("paid_by_user_id")
  ticketsSentAt  DateTime?         @map("tickets_sent_at")
  // Last send problem (no sender, PDF / Gmail error); null = fine.
  sendError      String?           @map("send_error")
  cancelledAt    DateTime?         @map("cancelled_at")
  cancelledById  String?           @map("cancelled_by_id")
  note           String?
  createdAt      DateTime          @default(now()) @map("created_at")

  event         Event          @relation(fields: [eventId], references: [id])
  tickets       Ticket[]
  bankMovements BankMovement[]

  @@unique([eventId, number])
  @@index([eventId, status])
  @@index([variableSymbol])
  @@map("ticket_orders")
}

// One ticket = one page of the order's PDF with its own check-in QR.
model Ticket {
  id         String    @id @default(uuid())
  orderId    String    @map("order_id")
  eventId    String    @map("event_id")
  // Random, not guessable (src/lib/tickets.ts newTicketCode) -- what the QR holds.
  code       String    @unique
  // 1..n within the order ("vstupenka 2/4").
  seq        Int
  priceKey   String    @map("price_key")
  priceLabel String    @map("price_label")
  usedAt     DateTime? @map("used_at")
  // User id, or "link" (the secret scan link).
  usedBy     String?   @map("used_by")

  order TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("tickets")
}


// ===== Kuchyně (docs/kitchen-planning-design.md, phase 1) =====
// The library (ingredients, meals) is the organization's; everything else belongs to an event.
// No prices, no nutrition: the only norm is grams (ml, pieces) per portion of a standard adult.

model Ingredient {
  id                 String         @id @default(uuid())
  organizationId     String         @map("organization_id")
  name               String
  // name lower-cased, without diacritics and spaces doubled -- unique per organization ("Mouka hladká" = "mouka hladka").
  nameKey            String         @map("name_key")
  unit               IngredientUnit
  allergens          String[]       @default([])
  // What it contains: meat, pork, fish, dairy, egg (src/lib/kitchen/allergens.ts CONTENT_FLAGS).
  dietFlags          String[]       @default([]) @map("diet_flags")
  // AI-guessed or unchecked allergens are "neověřeno" until a human confirms them.
  allergensConfirmed Boolean        @default(false) @map("allergens_confirmed")
  // "Vždy v kuchyni" (salt, spices…): no exact quantity needed, not on the shopping list's amounts.
  pantry             Boolean        @default(false)
  // Another way to count it: "stroužek" for garlic (in ks), "hrnek" = 140 g for flour.
  altUnitName        String?        @map("alt_unit_name")
  // How many base units (unit) one altUnitName is.
  altUnitQty         Decimal?       @map("alt_unit_qty") @db.Decimal(12, 3)
  packSize           Decimal?       @map("pack_size") @db.Decimal(12, 3)
  packUnit           String?        @map("pack_unit")
  shelfLifeDays      Int?           @map("shelf_life_days")
  storeHint          String?        @map("store_hint")
  category           String?
  globalId           String?        @map("global_id")
  syncedAt           DateTime?      @map("synced_at")
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  organization   Organization     @relation(fields: [organizationId], references: [id])
  mealUses       MealIngredient[]
  shoppingChecks ShoppingCheck[]

  @@unique([organizationId, nameKey])
  @@index([organizationId])
  @@map("ingredients")
}

model Meal {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  name             String
  nameKey          String    @map("name_key")
  // A slot hint (snídaně, oběd…), free text.
  mealType         String?   @map("meal_type")
  // The recipe is written for this many standard adult portions.
  yieldPortions    Int       @default(10) @map("yield_portions")
  prepMinutes      Int?      @map("prep_minutes")
  cookMinutes      Int?      @map("cook_minutes")
  equipment        String?
  prepAheadOk      Boolean   @default(false) @map("prep_ahead_ok")
  leftoverFriendly Boolean   @default(false) @map("leftover_friendly")
  coldPackable     Boolean   @default(false) @map("cold_packable")
  tags             String[]  @default([])
  steps            String?
  // "Vytvořit variantu jídla": the meal it was forked from.
  parentMealId     String?   @map("parent_meal_id")
  archivedAt       DateTime? @map("archived_at")
  globalId         String?   @map("global_id")
  syncedAt         DateTime? @map("synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  parentMeal   Meal?            @relation("MealFork", fields: [parentMealId], references: [id], onDelete: SetNull)
  forks        Meal[]           @relation("MealFork")
  ingredients  MealIngredient[]
  variants     MealVariant[]
  notes        MealNote[]
  planEntries  PlanEntry[]

  @@index([organizationId])
  @@index([organizationId, nameKey])
  @@map("meals")
}

model MealIngredient {
  id                 String  @id @default(uuid())
  mealId             String  @map("meal_id")
  ingredientId       String  @map("ingredient_id")
  // In the ingredient's unit, for one standard adult portion.
  qtyPerAdultPortion Decimal @map("qty_per_adult_portion") @db.Decimal(12, 3)
  // main / starch / vegetable / sauce / side
  role               String?
  optional           Boolean @default(false)
  note               String?
  sortOrder          Int     @default(0) @map("sort_order")

  meal       Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([mealId])
  @@map("meal_ingredients")
}

model MealVariant {
  id              String   @id @default(uuid())
  mealId          String   @map("meal_id")
  // e.g. "bezlepková"
  name            String
  clearsAllergens String[] @default([]) @map("clears_allergens")
  // [{ fromIngredientId, toIngredientId, qtyPerAdultPortion? }]
  swaps           Json     @default("[]")

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("meal_variants")
}

model MealNote {
  id           String   @id @default(uuid())
  mealId       String   @map("meal_id")
  // Set = a note from this event; null = a library note ("Převést do knihovny").
  eventId      String?  @map("event_id")
  body         String
  authorUserId String?  @map("author_user_id")
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  meal  Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("meal_notes")
}

model EventKitchenSettings {
  eventId               String   @id @map("event_id")
  // The participants' allergy field (default: the field whose key / label is "alergie").
  allergyFieldKey       String?  @map("allergy_field_key")
  // The event's categories that count as "potraviny" (cena na osobu a den).
  foodCategoryIds       String[] @default([]) @map("food_category_ids")
  countOnlyAccepted     Boolean  @default(false) @map("count_only_accepted")
  feedbackUnlockMinutes Int      @default(30) @map("feedback_unlock_minutes")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_kitchen_settings")
}

model PlanEntry {
  id               String          @id @default(uuid())
  eventId          String          @map("event_id")
  date             DateTime        @db.Date
  slotItemId       String          @map("slot_item_id")
  planWindowId     String?         @map("plan_window_id")
  mealId           String?         @map("meal_id")
  customName       String?         @map("custom_name")
  variantIds       String[]        @default([]) @map("variant_ids")
  headcountMode    HeadcountMode   @default(auto) @map("headcount_mode")
  // Adult-equivalent portions (manual mode).
  manualPortions   Decimal?        @map("manual_portions") @db.Decimal(10, 2)
  // The accepted sizing multiplier (only ever set by "Použít").
  sizingMultiplier Decimal?        @map("sizing_multiplier") @db.Decimal(6, 3)
  // HH:mm
  servingTime      String?         @map("serving_time")
  status           PlanEntryStatus @default(draft)
  // Written on confirm: ingredients with quantities, variants, headcount, multiplier.
  recipeSnapshot   Json?           @map("recipe_snapshot")
  note             String?
  sortOrder        Int             @default(0) @map("sort_order")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slotItem EventListItem @relation("PlanEntrySlot", fields: [slotItemId], references: [id])
  meal     Meal?         @relation(fields: [mealId], references: [id], onDelete: SetNull)
  feedback MealFeedback?

  @@index([eventId, date])
  @@map("plan_entries")
}

// Anonymous extras only (visitors, "výlet bez oběda"); named adults are EventPerson.
model HeadcountAdjust {
  id         String         @id @default(uuid())
  eventId    String         @map("event_id")
  dateFrom   DateTime       @map("date_from") @db.Date
  dateTo     DateTime       @map("date_to") @db.Date
  slotItemId String?        @map("slot_item_id")
  // Negative allowed.
  count      Int
  label      String
  factor     Decimal        @default(1.0) @db.Decimal(6, 3)
  createdAt  DateTime       @default(now()) @map("created_at")

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slotItem EventListItem? @relation("HeadcountAdjustSlot", fields: [slotItemId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("headcount_adjusts")
}

// Exactly one of participantId / eventPersonId (also a SQL CHECK).
model MealAbsence {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  participantId String?        @map("participant_id")
  eventPersonId String?        @map("event_person_id")
  date          DateTime       @db.Date
  // null = the whole day.
  slotItemId    String?        @map("slot_item_id")
  reason        String?
  createdAt     DateTime       @default(now()) @map("created_at")

  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant?   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  eventPerson EventPerson?   @relation(fields: [eventPersonId], references: [id], onDelete: Cascade)
  slotItem    EventListItem? @relation("MealAbsenceSlot", fields: [slotItemId], references: [id], onDelete: Cascade)

  @@index([eventId, date])
  @@map("meal_absences")
}

// A participant's confirmed allergens / diet (Strava účastníků), from the allergy text it was confirmed against.
model ParticipantDiet {
  id            String    @id @default(uuid())
  participantId String    @unique @map("participant_id")
  allergens     String[]  @default([])
  dietFlags     String[]  @default([]) @map("diet_flags")
  rawText       String    @map("raw_text")
  rawTextHash   String    @map("raw_text_hash")
  confirmedById String?   @map("confirmed_by_id")
  confirmedAt   DateTime  @default(now()) @map("confirmed_at")
  note          String?
  // Audit 2026-11-05: words of the text that map to no allergen / diet ("anafylaxe", "nesmí ořechy"), as they
  // were when confirmed, and that the confirmer ticked "Nepřiřazené výrazy jsem posoudil/a" (else a note is required).
  unmapped         String[] @default([])
  unmappedReviewed Boolean  @default(false) @map("unmapped_reviewed")
  // audit2 K5: proposed allergens / diets the confirmer left unticked, and why ("" = ticked "Potvrzuji,
  // že dítě nemá tyto alergie").
  dropped          String[] @default([])
  droppedReason    String?  @map("dropped_reason")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("participant_diets")
}

model MealFeedback {
  id              String          @id @default(uuid())
  planEntryId     String          @unique @map("plan_entry_id")
  verdict         FeedbackVerdict
  leftoverPercent Int?            @map("leftover_percent")
  shortPercent    Int?            @map("short_percent")
  stars           Int?
  note            String?
  recordedById    String?         @map("recorded_by_id")
  recordedAt      DateTime        @default(now()) @map("recorded_at")

  planEntry PlanEntry @relation(fields: [planEntryId], references: [id], onDelete: Cascade)

  @@map("meal_feedback")
}

model ShoppingCheck {
  id           String     @id @default(uuid())
  eventId      String     @map("event_id")
  ingredientId String     @map("ingredient_id")
  forDate      DateTime   @map("for_date") @db.Date
  checked      Boolean    @default(false)
  qtyBought    Decimal?   @map("qty_bought") @db.Decimal(12, 3)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([eventId, ingredientId, forDate])
  @@map("shopping_checks")
}

// Osobní účtenky (2026-10-30): purchases for people that are NOT the event's official expense -- never in the
// bill lists, the accounting export, Rozpočet or the settlement. The author paid; the shares are what each
// person owes them. Shares are CZK (the bill's amountCzk split).
enum PersonalSplitMode {
  even
  custom
}

model PersonalBill {
  id               String            @id @default(uuid())
  eventId          String            @map("event_id")
  // Who paid; null = the event itself (paid from the event's money / cash box).
  authorId         String?           @map("author_id")
  billDate         DateTime          @map("bill_date") @db.Date
  merchantName     String?           @map("merchant_name")
  totalAmount      Decimal           @map("total_amount") @db.Decimal(12, 2)
  currency         Currency          @default(CZK)
  // null = a foreign currency without a ČNB rate yet (can't be split).
  amountCzk        Decimal?          @map("amount_czk") @db.Decimal(12, 2)
  exchangeRateUsed Decimal?          @map("exchange_rate_used") @db.Decimal(12, 6)
  splitMode        PersonalSplitMode @default(even) @map("split_mode")
  // Through the event (the default): the event pays the author back and the people pay the event (netted with
  // payouts on Platby). Off: the author settles with the people himself (person to person).
  viaEvent         Boolean           @default(true) @map("via_event")
  // Tally ("čárky": a keg of beer): price per piece; each share = quantity × unitPrice.
  unitLabel        String?           @map("unit_label")
  unitPrice        Decimal?          @map("unit_price") @db.Decimal(12, 2)
  // The receipt's lines as the AI read them (shown next to the form).
  lineItems        Json?             @map("line_items")
  note             String?
  // An optional photo / PDF of the receipt.
  gcsObjectPath    String?           @map("gcs_object_path")
  originalFilename String?           @map("original_filename")
  sizeBytes        BigInt?           @map("size_bytes")
  // Moved here from the official bills: the fields needed to move it back.
  fromBill         Json?             @map("from_bill")
  createdByUserId  String            @map("created_by_user_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  event  Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author Author?             @relation("PersonalBillAuthor", fields: [authorId], references: [id])
  shares PersonalBillShare[]

  @@index([eventId])
  @@map("personal_bills")
}

model PersonalBillShare {
  id              String    @id @default(uuid())
  personalBillId  String    @map("personal_bill_id")
  // Who owes their part to the bill's author.
  authorId        String    @map("author_id")
  amountCzk       Decimal   @map("amount_czk") @db.Decimal(12, 2)
  // Tally: how many pieces.
  quantity        Decimal?  @db.Decimal(10, 2)
  // The debtor paid (to the event, or to the author person to person).
  settledAt       DateTime? @map("settled_at")
  settledByUserId String?   @map("settled_by_user_id")
  // Through the event: the event paid this part back to the bill's author (with their payout).
  creditorPaidAt  DateTime? @map("creditor_paid_at")

  personalBill PersonalBill @relation(fields: [personalBillId], references: [id], onDelete: Cascade)
  author       Author       @relation(fields: [authorId], references: [id])

  // Several parts per person: a paid part stays as it was, what's added later is a new open part.
  @@index([personalBillId])
  @@index([authorId])
  @@map("personal_bill_shares")
}

// Vyúčtování (2026-11-01): one link per person per event (/vyuctovani/<event>/<token>, no login) showing what was
// counted -- official bills, personal parts -- the result, a QR and the confirmations. Amounts are always computed
// live (src/lib/settlement-links.ts); settling uses the bills' / shares' own flags.
model SettlementLink {
  id             String    @id @default(uuid())
  eventId        String    @map("event_id")
  authorId       String    @map("author_id")
  token          String    @unique
  // 7 digits starting with 9: matched on incoming payments (Fio) to settle automatically.
  variableSymbol String    @unique @map("variable_symbol")
  // "Zaplatil(a) jsem" (their claim, not proof) / "Peníze jsem dostal(a)" (their payout arrived).
  claimedAt      DateTime? @map("claimed_at")
  receivedAt     DateTime? @map("received_at")
  // "Souhlasím s vyúčtováním" (the event pays them): when, and the amount it was then.
  acceptedAt     DateTime? @map("accepted_at")
  acceptedAmount Decimal?  @map("accepted_amount") @db.Decimal(12, 2)
  // Person to person: { [creditorAuthorId]: ISO } -- "I paid them".
  pairClaims     Json      @default("{}") @map("pair_claims")
  // Bank movements already used to settle (never twice).
  paidMovementIds String[] @default([]) @map("paid_movement_ids")
  createdAt      DateTime  @default(now()) @map("created_at")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([eventId, authorId])
  @@map("settlement_links")
}

// A cancelled payment (2026-11-03, "Zrušit platbu" on a personal bill): the paid part is open again; this keeps
// what was cancelled, by whom and why (the reason is mandatory) -- shown in Platby -> Historie plateb.
model PaymentCorrection {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  authorId       String   @map("author_id")
  personalBillId String?  @map("personal_bill_id")
  title          String
  amountCzk      Decimal  @map("amount_czk") @db.Decimal(12, 2)
  // When it had been paid, and how (null user = the bank / the link).
  paidAt         DateTime? @map("paid_at")
  note           String
  userId         String?  @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("payment_corrections")
}

// Cestovní příkazy (docs/claude-code-prompt-7-travel-orders.md A2): the decree's rates, per organization,
// versioned by the day they apply from (prices changed twice in 2026, so never by year). A trip uses the set
// with the greatest validFrom not later than its start (src/lib/travel-order-calc.ts pickRateSet).
model TravelRateSet {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  validFrom           DateTime @map("valid_from") @db.Date
  basePerKm           Decimal  @map("base_per_km") @db.Decimal(8, 2)
  trailerSurchargePct Decimal  @map("trailer_surcharge_pct") @db.Decimal(5, 2)
  dieselPrice         Decimal  @map("diesel_price") @db.Decimal(8, 2)
  petrol95Price       Decimal  @map("petrol95_price") @db.Decimal(8, 2)
  petrol98Price       Decimal  @map("petrol98_price") @db.Decimal(8, 2)
  electricityPrice    Decimal  @map("electricity_price") @db.Decimal(8, 2)
  // { petrol: {manual, auto}, diesel: {manual, auto}, electric: {manual, auto} } l (kWh) / 100 km.
  consumptionDefaults Json     @map("consumption_defaults")
  // The source (decree number).
  note                String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, validFrom])
  @@map("travel_rate_sets")
}

enum VehicleGearbox {
  manual
  automatic
}

enum VehicleFuel {
  diesel
  petrol95
  petrol98
  electric
}

// Vozidla (A3): own cars used on travel orders. The owner is an adult in Lidé and/or a payer, else a plain name.
model Vehicle {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  label          String
  cylinderCc     Int?           @map("cylinder_cc")
  plate          String?
  gearbox        VehicleGearbox
  fuel           VehicleFuel
  // Consumption from the technical licence (TP), up to 4 values; the set ones > 0 are averaged.
  tpConsumption1 Decimal?       @map("tp_consumption_1") @db.Decimal(5, 2)
  tpConsumption2 Decimal?       @map("tp_consumption_2") @db.Decimal(5, 2)
  tpConsumption3 Decimal?       @map("tp_consumption_3") @db.Decimal(5, 2)
  tpConsumption4 Decimal?       @map("tp_consumption_4") @db.Decimal(5, 2)
  ownerChildId   String?        @map("owner_child_id")
  ownerAuthorId  String?        @map("owner_author_id")
  ownerName      String?        @map("owner_name")
  // Who added it (a non-admin edits only their own).
  createdByUserId String?       @map("created_by_user_id")
  archivedAt     DateTime?      @map("archived_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  ownerChild   Child?       @relation(fields: [ownerChildId], references: [id], onDelete: SetNull)
  ownerAuthor  Author?      @relation(fields: [ownerAuthorId], references: [id], onDelete: SetNull)
  travelOrders TravelOrder[]

  @@index([organizationId])
  @@map("vehicles")
}

enum TravelOrderStatus {
  draft
  submitted
}

// Cestovní příkaz (B1): one trip of one worker in their own car. A draft is edited freely; Odeslat freezes it:
// every snapshot below is written, the amounts computed (src/lib/travel-order-calc.ts) and a Bill created.
// Later edits of rates, people or cars never change a submitted order; Znovu otevřít recalculates with the
// same frozen rate values (rateValues).
model TravelOrder {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  eventId             String            @map("event_id")
  billId              String?           @unique @map("bill_id")
  status              TravelOrderStatus @default(draft)
  workerChildId       String?           @map("worker_child_id")
  workerAuthorId      String?           @map("worker_author_id")
  vehicleId           String?           @map("vehicle_id")
  // Worker / vehicle as set on this order (filled from Lidé / Plátci / Vozidla, editable here).
  workerName          String?           @map("worker_name")
  workerAddress       String?           @map("worker_address")
  workerPhone         String?           @map("worker_phone")
  vehicleLabel        String?           @map("vehicle_label")
  vehiclePlate        String?           @map("vehicle_plate")
  cylinderCc          Int?              @map("cylinder_cc")
  gearbox             VehicleGearbox?
  fuel                VehicleFuel?
  tpValues            Json?             @map("tp_values")
  // Payout (Vyplatit): bank | cash, to whom and where. A payee change touches only these and the bill's payer.
  payoutMethod        String            @default("bank") @map("payout_method")
  payoutName          String?           @map("payout_name")
  payoutAccountNumber String?           @map("payout_account_number")
  payoutBankCode      String?           @map("payout_bank_code")
  // Computed / frozen on submit.
  consumptionUsed     Decimal?          @map("consumption_used") @db.Decimal(6, 2)
  consumptionSource   String?           @map("consumption_source")
  fuelPriceUsed       Decimal?          @map("fuel_price_used") @db.Decimal(8, 2)
  priceFromReceipt    Boolean           @default(false) @map("price_from_receipt")
  // The receipt price per unit typed in (Použít cenu z účtenky).
  receiptPrice        Decimal?          @map("receipt_price") @db.Decimal(8, 2)
  rateSetId           String?           @map("rate_set_id")
  rateValues          Json?             @map("rate_values")
  purpose             String?
  originPlace         String?           @map("origin_place")
  destinationPlace    String?           @map("destination_place")
  roundTrip           Boolean           @default(true) @map("round_trip")
  startAt             DateTime?         @map("start_at")
  endAt               DateTime?         @map("end_at")
  approvalDate        DateTime?         @map("approval_date") @db.Date
  approverName        String?           @map("approver_name")
  coTravellers        String?           @map("co_travellers")
  // { ubytovani, snidane, obed, vecere }: printed only, changes no amount.
  freeMeals           Json?             @map("free_meals")
  receiptBillId       String?           @map("receipt_bill_id")
  totalKm             Decimal?          @map("total_km") @db.Decimal(9, 1)
  totalAmount         Decimal?          @map("total_amount") @db.Decimal(12, 2)
  pdfPath             String?           @map("pdf_path")
  submittedAt         DateTime?         @map("submitted_at")
  createdByUserId     String?           @map("created_by_user_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  bill         Bill?        @relation(fields: [billId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  legs         TravelLeg[]

  @@index([organizationId])
  @@index([eventId])
  @@map("travel_orders")
}

model TravelLeg {
  id         String    @id @default(uuid())
  orderId    String    @map("order_id")
  sortOrder  Int       @map("sort_order")
  date       DateTime? @db.Date
  fromPlace  String?   @map("from_place")
  toPlace    String?   @map("to_place")
  // "HH:MM"
  departTime String?   @map("depart_time")
  arriveTime String?   @map("arrive_time")
  trailer    Boolean   @default(false)
  km         Decimal?  @db.Decimal(8, 1)
  stravne    Decimal?  @db.Decimal(10, 2)
  nocleh     Decimal?  @db.Decimal(10, 2)
  vedlejsi   Decimal?  @db.Decimal(10, 2)
  // Computed, stored on submit (jízdné, celkem).
  kmAmount   Decimal?  @map("km_amount") @db.Decimal(12, 2)
  amount     Decimal?  @db.Decimal(12, 2)

  order TravelOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("travel_legs")
}

// Distances from submitted orders (from -> to, as typed): a suggestion in the legs table, never applied silently.
model KnownDistance {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  fromPlace      String   @map("from_place")
  toPlace        String   @map("to_place")
  km             Decimal  @db.Decimal(8, 1)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, fromPlace, toPlace])
  @@map("known_distances")
}

// Místa of an event's travel orders (2026-11-03): one shared list, offered in every leg's Odkud / Kam.
model TravelPlace {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, name])
  @@map("travel_places")
}

// Šablony cest (2026-11-03): a trip that repeats (same route, other people / cars), organization-wide. data =
// { purpose, originPlace, destinationPlace, roundTrip, legs: [{ dayOffset, fromPlace, toPlace, departTime,
// arriveTime, trailer, km, stravne, nocleh, vedlejsi }] } -- never a worker, car or account.
model TravelTemplate {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String
  data            Json
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("travel_templates")
}
