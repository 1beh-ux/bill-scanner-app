generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  accountant
  user
}

enum EventStatus {
  active
  closed
}

// membership = the organisation's yearly membership registration (Členský
// rok), run through the same participants/acceptance/payment machinery as a
// camp. See docs/registration-membership.md.
enum EventKind {
  event
  membership
  // Veřejná akce (docs/public-event-tickets-spec.md): ticket sales, no participants.
  public_event
}

// pending: just entered the roster (manually, pasted, or imported from a
// registration Sheet) and hasn't been reviewed yet. accepted: an admin
// decided to accept them and (normally) sent the acceptance email -- see
// REGISTRATION_ACCEPTANCE_PURPOSE_KEY. No "rejected" state yet -- not asked
// for, add one if that's ever a real need.
// What happens to a registration made in the parent portal / on the public
// page (docs/registration-slice3-spec.md E; imports and manual adds never):
// manual = stays pending (default, as before); accept = accepted, nothing
// sent; accept_send = accepted + documents + the acceptance e-mail with the
// event's template unedited (same code path as "Přijmout a odeslat").
enum AutoAccept {
  manual
  accept
  accept_send
}

enum RegistrationStatus {
  pending
  accepted
}

enum IngestChannel {
  drive
  upload
  camera
  // Banka: created from a bank transaction ("Vytvořit doklad z platby").
  bank
  // Typed in by hand (2026-11-01): an estimate or a bill whose document isn't here yet (documentMissing).
  manual
  // Cestovní příkazy (2026-11-03): created by submitting a travel order; the document is its generated PDF.
  // Never goes through the AI pipeline.
  travel_order
}

enum BillStatus {
  new
  queued
  processing
  auto_approved
  to_review
  failed
  approved
}

enum Currency {
  CZK
  PLN
  EUR
}

enum AuditActionType {
  edit
  approve
  reopen
  // Banka: pairing with a bank transaction (docs/bank-reconciliation.md).
  bank_pair
  bank_unpair
  bank_reject
  bank_create
  bank_replace
  bank_channel
}

enum ModuleKey {
  bills
  health
  mail
  planning
  // Banka (bank reconciliation): explicit per-event grant only, admins included (src/lib/module-access.ts).
  bank
  // Účastníci (central roster, documents, sending): on its own, without Zdraví / Pošta. Those two
  // still reach the roster too (they work on the same participants).
  participants
  // Vstupenky (public events, docs/public-event-tickets-spec.md): orders + the check-in scan page.
  tickets
  // Kuchyně (docs/kitchen-planning-design.md): the camp's adults on the event (Dospělí na akci) and the kitchen.
  kitchen
}

enum IncidentCategory {
  illness
  injury
  parasite
  medication
  other
}

enum BodyView {
  front
  back
}

enum IncidentUpdateType {
  correct
  void
}

enum ListTemplateKind {
  med
  slot
  situation
  document
  // Planning Helper (see docs/planning-helper-module-design.md)
  plan_category
  plan_location
  plan_leader
  plan_day_template
  // org base library only -- event activities live in PlanActivity
  plan_activity
  // Kuchyně (docs/kitchen-planning-design.md): meal slots (data { defaultTime? }) and age bands
  // (data { ageFrom, ageTo, factor }) -- the kitchen module's (requireListItemAccess).
  kitchen_slot
  kitchen_band
  // Kuchyně diets (organization-wide, Šablony -> Kuchyně): data { keywords[], contents[], allergens[] }.
  kitchen_diet
  // Osobní účtenky: repeated items with a base price per piece (pivo, limonáda); data { unitPrice }.
  personal_item
}

enum IngredientUnit {
  g
  ml
  ks
}

enum PlanEntryStatus {
  draft
  confirmed
  cooked
}

enum HeadcountMode {
  auto
  manual
}

enum FeedbackVerdict {
  short
  ok
  leftover
}

enum ParentEmailStatus {
  sent
  failed
}

enum MailDocReceivedVia {
  email
  manual
  // System-generated (the registration-document merge on acceptance send,
  // see src/lib/document-merge.ts + src/lib/participant-document-store.ts)
  // rather than something a guardian sent in.
  generated
  // Ticked by a participant table sync (a questionnaire sheet row exists for
  // them -- ParticipantSync.markDocumentId, src/lib/participant-sync-run.ts).
  sheet
  // Uploaded by a parent in the portal instead of e-mailing it (slice 3 F;
  // only for document types with allowPortalUpload). No receiving user.
  portal
  // Matched from the organization's Fio account (docs/bank-payments-design.md).
  // No file, no receiving user.
  bank
}

enum MailActionType {
  bulk_move
  bulk_delete
  attachment_saved
  // Manual received/missing toggle on the Mail participants working list
  // (Part 2 of the participants/settings/Health/Mail prompt) -- see
  // .../participants/[participantId]/documents/[docTypeId]/route.ts.
  document_marked
  document_unmarked
}

enum MailActionStatus {
  ok
  error
}

enum UserLang {
  cs
  en
}

enum UserTheme {
  light
  dark
}

model User {
  id                 String      @id @default(uuid())
  email              String      @unique
  displayName        String
  role               UserRole
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  // Personal preferences (src/app/api/me/route.ts, src/lib/i18n.tsx) --
  // localStorage still seeds the instant paint before this loads, then
  // reconciles to these once /api/me resolves.
  preferredLang      UserLang    @default(cs) @map("preferred_lang")
  preferredTheme     UserTheme   @default(light) @map("preferred_theme")
  landingPath        String?     @map("landing_path")
  // Overrides {{sender_name}} in outgoing emails (src/lib/parent-email-send.ts,
  // src/lib/mail-bulk-status-send.ts, src/lib/participant-bulk-email.ts) --
  // an Outlook-signature-style personal setting, falling back to
  // displayName when unset.
  emailSignature     String?     @map("email_signature")
  // Multi-line signature for the e-mail TEXT, {{signature}} in templates
  // (falls back to the name above) -- see senderIdentity() in src/lib/email-template.ts.
  emailBodySignature String?     @map("email_body_signature")
  // Second settings layer: modules a person has chosen to hide from their own
  // sidebar. Admin decides what they *have* (UserEventModuleAccess); this only
  // narrows their own view, never grants anything.
  hiddenModules      ModuleKey[] @default([]) @map("hidden_modules")
  // Small per-person UI preferences that should follow the user across
  // devices (see src/lib/ui-prefs.ts for the allowed keys).
  uiPrefs            Json?       @map("ui_prefs")

  moduleAccess           UserEventModuleAccess[]
  driveAccount           DriveAccount?           @relation("DriveAccountConnectedBy")
  eventsDriveConfigured  Event[]                 @relation("EventDriveConfiguredBy")
  authorBankAudits       AuthorBankAudit[]       @relation("AuthorBankAuditChangedBy")
  billsCreated           Bill[]                  @relation("BillCreatedBy")
  billsApproved          Bill[]                  @relation("BillApprovedBy")
  billsPaid              Bill[]                  @relation("BillPaidBy")
  auditLogEntries        BillAuditLog[]
  incidentsCreated       Incident[]              @relation("IncidentCreatedBy")
  incidentUpdates        IncidentUpdate[]        @relation("IncidentUpdatedBy")
  medChecklistGiven      MedChecklist[]          @relation("MedChecklistGivenBy")
  parentEmailsSent       ParentEmailLog[]        @relation("ParentEmailSentBy")
  mailAccountsConnected  MailSenderAccount[]     @relation("MailAccountConnectedBy")
  documentsReceived      ParticipantDocument[]   @relation("ParticipantDocumentReceivedBy")
  mailActionsPerformed   MailActionLog[]         @relation("MailActionLogUser")
  childChangesDecided    ChildChange[]           @relation("ChildChangeDecidedBy")
  documentsReviewed      ParticipantDocument[]   @relation("ParticipantDocumentReviewedBy")
  personDocumentsCreated PersonDocument[]        @relation("PersonDocumentCreatedBy")
  personDocumentsRevoked PersonDocument[]        @relation("PersonDocumentRevokedBy")
  childEmailsSent        ChildEmailLog[]         @relation("ChildEmailSentBy")
  bankTokensSet          BankAccount[]           @relation("BankAccountTokenSetBy")
  bankMovementsDecided   BankMovement[]          @relation("BankMovementDecidedBy")

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Sees and manages every organization (organizations step 2+).
  isSuperAdmin   Boolean      @default(false) @map("is_super_admin")

  @@index([organizationId])
  @@map("users")
}

model Module {
  key  ModuleKey @id
  name String

  @@map("modules")
}

model EventModule {
  eventId   String    @map("event_id")
  moduleKey ModuleKey @map("module_key")
  enabled   Boolean   @default(false)

  event Event @relation(fields: [eventId], references: [id])

  @@id([eventId, moduleKey])
  @@map("event_modules")
}

model UserEventModuleAccess {
  userId    String    @map("user_id")
  eventId   String    @map("event_id")
  moduleKey ModuleKey @map("module_key")

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@id([userId, eventId, moduleKey])
  @@map("user_event_module_access")
}

model Event {
  id                            String         @id @default(uuid())
  name                          String
  // Audit 2026-11-05: a test event -- "TEST" badge; its participants are never linked into Lidé, and it stays
  // out of Lidé's unlinked list, cross-event pickers, the portal's offer and Využití totals (src/lib/test-events.ts).
  isTest                        Boolean        @default(false) @map("is_test")
  startDate                     DateTime       @map("start_date") @db.Date
  endDate                       DateTime       @map("end_date") @db.Date
  status                        EventStatus    @default(active)
  driveIngestFolderId           String?        @map("drive_ingest_folder_id")
  driveExportFolderId           String?        @map("drive_export_folder_id")
  driveManifestSpreadsheetId    String?        @map("drive_manifest_spreadsheet_id")
  // Each export in its own folder (2026-11-03, Nastavení akce -> Připojení); null = the bill export folder
  // (driveExportFolderId) as before. src/lib/drive-folders.ts.
  driveManifestFolderId         String?        @map("drive_manifest_folder_id")
  driveHealthFolderId           String?        @map("drive_health_folder_id")
  driveParticipantsListFolderId String?        @map("drive_participants_list_folder_id")
  drivePlanningFolderId         String?        @map("drive_planning_folder_id")
  driveTicketsFolderId          String?        @map("drive_tickets_folder_id")
  // Where per-participant folders (registration documents, received/generated
  // files) live -- separate from the bills export folder above. Null falls
  // back to driveExportFolderId (the old shared behavior).
  driveParticipantsFolderId     String?        @map("drive_participants_folder_id")
  // Zpracované soubory: Drive import moves imported files here (src/lib/drive-import.ts); the
  // "Úklid souborů na Disku" tool's default target.
  driveProcessedFolderId        String?        @map("drive_processed_folder_id")
  // One Drive export at a time (src/lib/drive-export.ts): set while a run is uploading, expires on its
  // own if the run dies. Two overlapping runs uploaded the same files twice (2026-10-17).
  driveExportLockedUntil        DateTime?      @map("drive_export_locked_until")
  // The user whose connected Google account does this event's Drive work (see
  // DriveAccount). Set when someone saves the event's Drive folders, when a user
  // connects from the Drive tab and none is set, or via "take over".
  driveConfiguredByUserId       String?        @map("drive_configured_by_user_id")
  senderEmail                   String?        @map("sender_email")
  driveDocSyncEnabled           Boolean        @default(true) @map("drive_doc_sync_enabled")
  statusExportEnabled           Boolean        @default(true) @map("status_export_enabled")
  statusExportSheetId           String?        @map("status_export_sheet_id")
  statusExportLastSyncedAt      DateTime?      @map("status_export_last_synced_at")
  mailDoneLabelName             String?        @map("mail_done_label_name")
  mailQuestionnaireUrl          String?        @map("mail_questionnaire_url")
  // Optional -- {{registration_deadline}} (Part 11 of the participants/settings
  // prompt). Omitted (not defaulted to a hardcoded date) when null, so the
  // acceptance e-mail/document sentence that uses it is simply left out instead
  // of ever printing a wrong or contradicting date.
  registrationDeadline          DateTime?      @map("registration_deadline") @db.Date
  // Persisted registration-sheet connection (Seznam účastníků import
  // settings) -- set once, reused on every future import instead of
  // re-pasting the sheet id and remapping columns each time. Mapping is
  // stored keyed by header name (not column index), since sheet columns can
  // be reordered between imports; unrecognized headers fall back to the
  // same guess-from-header-text heuristic as before.
  participantsSheetId           String?        @map("participants_sheet_id")
  participantsColumnMapping     Json?          @map("participants_column_mapping")
  // Participant table connections (src/lib/participant-sync.ts ParticipantSync[]);
  // the two columns above are the old single connection, converted on first read.
  participantSyncs              Json?          @map("participant_syncs")
  // Camp-fee collection, used by the registration-document merge (price +
  // QR payment code) -- deliberately separate from any bill/reimbursement
  // bank account elsewhere in the app; this is the org's own fee account.
  memberPriceCzk                Int?           @map("member_price_czk")
  nonMemberPriceCzk             Int?           @map("non_member_price_czk")
  registrationBankAccountNumber String?        @map("registration_bank_account_number")
  registrationBankCode          String?        @map("registration_bank_code")
  // Variable-symbol formula config (computed field, see
  // src/lib/document-variables.ts's buildVariableSymbol): year comes from
  // startDate, vsEventType/vsOrderInYear are admin-typed single digits,
  // vsMembershipFieldKey names the boolean custom field whose "true" value
  // sets the membership digit to 1 (else 0). Null vsMembershipFieldKey means
  // no membership digit is configured -- always 0.
  // Two-digit year override (e.g. 27 for a registration run in 2026 for
  // next year); null = from startDate.
  vsYear                        Int?           @map("vs_year")
  vsEventType                   Int?           @map("vs_event_type")
  vsOrderInYear                 Int?           @map("vs_order_in_year")
  // Values of the membership field that mean "member" (lower-cased); null =
  // DEFAULT_MEMBER_VALUES in src/lib/document-variables.ts.
  vsMemberValues                Json?          @map("vs_member_values")
  vsMembershipFieldKey          String?        @map("vs_membership_field_key")
  // Side length (mm) of the payment QR image inserted into documents. Null
  // means the default (DEFAULT_QR_SIZE_MM in src/lib/document-variables.ts).
  qrSizeMm                      Int?           @map("qr_size_mm")
  // Ordered EventParticipantField keys chosen for the central roster's
  // columns (Name is always first and isn't included here). Null means not
  // configured yet -- falls back to every active field with the `list`
  // surface, in API order (the old, always-on behavior).
  participantsListColumns       Json?          @map("participants_list_columns")
  // Ordered column keys chosen for the bills list (src/lib/bill-columns.ts). Stored per
  // event, so everyone with access sees the same columns; null = the default set.
  // (A Json array like participantsListColumns -- Prisma has no nullable scalar list.)
  billsListColumns              Json?          @map("bills_list_columns")
  // Ordered filter pills shown above the bills list ("status:new", "paid", "pay:bank"...); null = all.
  billsListPills                Json?          @map("bills_list_pills")
  // Ordered participant-field keys shown as columns in the Documents overview
  // (mail_list fields); null = all of them. Saved via /mail/sync-settings.
  documentsListColumns          Json?          @map("documents_list_columns")
  // Optional field columns of the Zdraví list (ordered keys); null = none.
  healthListColumns             Json?          @map("health_list_columns")
  // Planning Helper settings (src/lib/planning.ts PlanningSettings): saved
  // import sheet connections per import target, and the Drive export sheet id.
  planningSettings              Json?          @map("planning_settings")
  // Zdravotní poznámky config (src/lib/health-notes.ts HealthNoteConfig[]):
  // which fields, in what order, where shown, highlighted. null = default.
  healthNotes                   Json?          @map("health_notes")
  // Participant detail / Zdraví detail layouts (src/lib/participant-layout.ts
  // ParticipantLayout: { detail?, health? }). null = the built-in layout.
  participantLayout             Json?          @map("participant_layout")
  // Registration & membership (docs/registration-membership.md). All off by
  // default: an unconnected event behaves exactly as before.
  kind                          EventKind      @default(event)
  // Only for kind = membership: the calendar year the membership counts for.
  membershipYear                Int?           @map("membership_year")
  // Which membership year a regular event checks (Nastavení akce -> Akce -> Členství); null = the
  // calendar year of its start (src/lib/children.ts memberChildIds).
  membershipCheckYear           Int?           @map("membership_check_year")
  // On: participants get linked to Child profiles, and member pricing reads
  // the child's accepted membership for the event's start year.
  registrationConnected         Boolean        @default(false) @map("registration_connected")
  // "Odpojit od Lidé": this event's participants are unlinked from the people
  // list and never linked again (not even by Lidé's "Propojit"), until reconnected.
  peopleUnlinked                Boolean        @default(false) @map("people_unlinked")
  // Slice 8 #3: which participants auto-linking may link -- `all` (today:
  // everyone, creating missing people) or `existing` (only to people already
  // in Lidé, never creating one). src/lib/children.ts linkChildren.
  peopleLinkMode                PeopleLinkMode @default(all) @map("people_link_mode")
  // Parent portal (docs/registration-portal-spec.md H): "Otevřeno pro přihlášky
  // v portálu" -- only used when the event is connected (or a membership year),
  // hidden after registrationDeadline. eligibility = src/lib/portal-rules.ts
  // Eligibility ({ everyone?, birthYearFrom?, birthYearTo?, groups?,
  // attendedEventIds?, childIds? }); null/empty = nobody.
  portalOpen                    Boolean        @default(false) @map("portal_open")
  eligibility                   Json?
  // Price rules (docs/registration-slice3-spec.md C, src/lib/price-rules.ts
  // PriceRules: categories, school-year date, household minimum). null =
  // today's pricing exactly (memberPriceCzk / nonMemberPriceCzk by isMember).
  priceRules                    Json?          @map("price_rules")
  // Public registration page /r/<publicSlug> (docs/registration-slice3-spec.md
  // D): landing info (markdown) + the new-family form. Off by default; only
  // used for a membership year or a connected event.
  publicRegistration            Boolean        @default(false) @map("public_registration")
  publicSlug                    String?        @unique @map("public_slug")
  landingContent                String?        @map("landing_content")
  // Public page without the organization name, title and dates (embedded on a page that has its own).
  publicHideHeader              Boolean        @default(false) @map("public_hide_header")
  // This event's own look of its /r page (a partial layer over the organization's), embedded or not.
  appearance                    Json?          @map("appearance")
  // This event's own wording of its registration page texts, over the organization's (Organization.publicTexts).
  publicTexts                   Json?          @map("public_texts")
  // Documents attached to each participant e-mail of this event: { purposeKey: [document type ids] }
  // (Nastavení akce -> Pošta; src/lib/email-attachments.ts). Fixed ones go as they are, others are generated per person.
  emailAttachments              Json?          @map("email_attachments")
  // Uploaded files each e-mail of this event carries, on top of the organization's: { purposeKey: EmailFile[] }
  // (src/lib/email-files.ts).
  emailFiles                    Json?          @map("email_files")
  // Participant export to Drive: its columns in order (field keys); null = the organization's, else all.
  exportColumns                 Json?          @map("export_columns")
  // Léky a výdej (src/lib/meds-page-settings.ts): font size, the date buttons shown + the first one, print defaults.
  medsPageSettings              Json?          @map("meds_page_settings")
  autoAccept                    AutoAccept     @default(manual) @map("auto_accept")
  // Shown on the portal's registration card (slice 3 F): place + a short info.
  location                      String?
  portalInfo                    String?        @map("portal_info")
  // "Dokument platby" (slice 4 #5): the document type (EventListItem id) whose
  // receipt means "paid" in the portal; never uploadable there. null = none.
  paymentDocTypeId              String?        @map("payment_doc_type_id")
  // Bills manifest category layout (src/lib/manifest.ts): "pairs" (null, Kategorie n + Částka n)
  // or "columns" (one column per category, named by it, amounts only).
  manifestCategoryMode          String?        @map("manifest_category_mode")
  // Automatic payment check (docs/bank-payments-design.md): settled bank
  // movements on this account create the paymentDocTypeId document.
  bankCheckEnabled              Boolean        @default(false) @map("bank_check_enabled")
  // Minutes between automatic payment checks of this event (cron every minute; the account is
  // checked when its most frequent event is due). Null = 30. Fio allows one call per token per 30 s.
  bankCheckIntervalMin          Int?           @map("bank_check_interval_min")
  // The contact on this event's public page (else the organization's contactEmail).
  publicContactEmail            String?        @map("public_contact_email")
  // Who the public form registers (2026-10-23): children | children_adults (adults only with a child) |
  // any (adults alone too). Null = any. The form starts with a child either way.
  publicAudience                String?        @map("public_audience")
  // Two-step registration (2026-10-23): registering asks only the basic profile fields; detailed ones and
  // the event's questions after acceptance (portal card / the participant's link). src/lib/registration-fields.ts askedNow.
  detailsAfterAcceptance        Boolean        @default(false) @map("details_after_acceptance")
  bankAccountId                 String?        @map("bank_account_id")
  bankAccount                   BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  // Veřejná akce (kind public_event): src/lib/tickets.ts TicketSettings (max per order, total limit,
  // VS prefix). Price types = priceRules categories (+ capacity). null = defaults.
  ticketSettings                Json?          @map("ticket_settings")
  // Secret link for the door check-in without a login (/vstup/<token>); null = no link.
  ticketScanToken               String?        @unique @map("ticket_scan_token")
  createdAt                     DateTime       @default(now()) @map("created_at")
  closedAt                      DateTime?      @map("closed_at")

  categories             EventCategory[]
  modules                EventModule[]
  moduleAccess           UserEventModuleAccess[]
  authorAccess           AuthorEventAccess[]
  authorBankAudits       AuthorBankAudit[]
  driveConfiguredBy      User?                   @relation("EventDriveConfiguredBy", fields: [driveConfiguredByUserId], references: [id])
  bills                  Bill[]
  participants           Participant[]
  eventListItems         EventListItem[]
  personDocuments        PersonDocument[]
  eventEmailTemplates    EventEmailTemplate[]
  mailActionLogs         MailActionLog[]
  eventParticipantFields EventParticipantField[]
  planDays               PlanDay[]
  planActivities         PlanActivity[]
  publicHosts            PublicHost[]
  deposits               EventDeposit[]
  incomes                EventIncome[]
  aiUsage                AiUsage[]
  bankLinks              EventBankAccount[]
  bankTransactions       BankTransaction[]
  bankImportBatches      BankImportBatch[]
  ticketOrders           TicketOrder[]
  // Osobní účtenky (2026-10-30): who pays out the event's reimbursements -- personal bills they paid for are
  // netted with each person's payout (src/lib/personal-bills.ts).
  treasurerAuthorId String? @map("treasurer_author_id")
  treasurer         Author? @relation("EventTreasurer", fields: [treasurerAuthorId], references: [id], onDelete: SetNull)
  personalBills     PersonalBill[]
  // Where people pay the event (settlement links): "treasurer" = the Pokladník's own account (and Fio token),
  // "event" = the event's bank account (Banka).
  settlementReceiver String @default("treasurer") @map("settlement_receiver")
  settlementLinks    SettlementLink[]
  paymentCorrections PaymentCorrection[]
  // The texts sent with the links (Platby): { owes, owed, both } with {jmeno} {akce} {castka} {odkaz}.
  settlementMessages Json?  @map("settlement_messages")
  eventPersons           EventPerson[]
  kitchenSettings        EventKitchenSettings?
  planEntries            PlanEntry[]
  headcountAdjusts       HeadcountAdjust[]
  mealAbsences           MealAbsence[]
  shoppingChecks         ShoppingCheck[]
  mealNotes              MealNote[]

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  travelOrders TravelOrder[]
  travelPlaces TravelPlace[]

  @@map("events")
}

model CategoryTemplate {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Owner (docs/organizations-change-notes.md).
  organizationId   String?            @map("organization_id")
  organization     Organization?      @relation(fields: [organizationId], references: [id])
  // The template this one was copied from (organizations step 4); unused for now.
  sourceTemplateId String?            @map("source_template_id")
  sourceTemplate   CategoryTemplate?  @relation("CategoryTemplateSource", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies           CategoryTemplate[] @relation("CategoryTemplateSource")

  // Per organization; NULL (app level) counts as one group: NULLS NOT DISTINCT in the migration SQL.
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("category_templates")
}

model EventCategory {
  id                 String  @id @default(uuid())
  eventId            String  @map("event_id")
  name               String
  description        String?
  budgetAmount       Decimal @map("budget_amount") @db.Decimal(12, 2)
  isFromTemplate     Boolean @default(false) @map("is_from_template")
  // The CategoryTemplate it was copied from -- sync matches by this, so a
  // category renamed for this event isn't copied from the template again.
  categoryTemplateId String? @map("category_template_id")

  event          Event          @relation(fields: [eventId], references: [id])
  billCategories BillCategory[]

  @@map("event_categories")
}

model Author {
  id                 String   @id @default(uuid())
  canonicalName      String   @map("canonical_name")
  bankAccountNumber  String?  @map("bank_account_number")
  bankCode           String?  @map("bank_code")
  mergedIntoAuthorId String?  @map("merged_into_author_id")
  active             Boolean  @default(true)
  // The organization's official bank account (bills it paid = spent directly by the organization,
  // never paid out; manifest summary / budget settlement). Implies payoutNeeded = false.
  isOfficialAccount  Boolean  @default(false) @map("is_official_account")
  // false = nobody is paid out for this payer's bills (like "Akce"): no "Proplaceno" to track.
  payoutNeeded       Boolean  @default(true) @map("payout_needed")
  createdAt          DateTime @default(now()) @map("created_at")

  // The person in Lidé this payer is (2026-10-30, personal bills: an adult picked as a share holder).
  childId            String?  @map("child_id")
  // Their own Fio API token (read-only), encrypted (src/lib/bank/token-crypto.ts): payments into their account
  // carrying a settlement link's variable symbol are confirmed automatically. Never sent to a client.
  fioTokenEncrypted  String?   @map("fio_token_encrypted")
  fioTokenSetAt      DateTime? @map("fio_token_set_at")
  // One Fio call per token per 30 s: claimed here before each call (src/lib/settlement-links.ts).
  fioLastCheckedAt   DateTime? @map("fio_last_checked_at")
  fioLastSuccessAt   DateTime? @map("fio_last_success_at")
  fioLastError       String?   @map("fio_last_error")
  // Cestovní příkazy (2026-11-03): a payer's own contact when they are not linked to an adult in Lidé
  // (an adult's comes from Lidé: address fields, first guardian's phone). Phone stored as "+420 xxx xxx xxx".
  phone              String?
  address            String?

  mergedInto  Author?             @relation("AuthorMerge", fields: [mergedIntoAuthorId], references: [id])
  child       Child?              @relation(fields: [childId], references: [id], onDelete: SetNull)
  personalBills      PersonalBill[]      @relation("PersonalBillAuthor")
  personalShares     PersonalBillShare[]
  settlementLinks    SettlementLink[]
  treasurerOf        Event[]             @relation("EventTreasurer")
  mergedFrom  Author[]            @relation("AuthorMerge")
  eventAccess AuthorEventAccess[]
  bills       Bill[]
  bankAudits  AuthorBankAudit[]
  vehicles    Vehicle[]

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("authors")
}

enum AuthorBankAuditSource {
  event_edit
  admin_edit
  merge
  create
  import
  // The person themselves, on their settlement link (/vyuctovani).
  settlement_link
}

// Every change of a payer's bank account/code (who, when, old -> new, and
// which event it was made from). Written in the same transaction as the change.
model AuthorBankAudit {
  id                   String                @id @default(uuid())
