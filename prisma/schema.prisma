generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  accountant
  user
}

enum EventStatus {
  active
  closed
}

// membership = the organisation's yearly membership registration (Členský
// rok), run through the same participants/acceptance/payment machinery as a
// camp. See docs/registration-membership.md.
enum EventKind {
  event
  membership
}

// pending: just entered the roster (manually, pasted, or imported from a
// registration Sheet) and hasn't been reviewed yet. accepted: an admin
// decided to accept them and (normally) sent the acceptance email -- see
// REGISTRATION_ACCEPTANCE_PURPOSE_KEY. No "rejected" state yet -- not asked
// for, add one if that's ever a real need.
// What happens to a registration made in the parent portal / on the public
// page (docs/registration-slice3-spec.md E; imports and manual adds never):
// manual = stays pending (default, as before); accept = accepted, nothing
// sent; accept_send = accepted + documents + the acceptance e-mail with the
// event's template unedited (same code path as "Přijmout a odeslat").
enum AutoAccept {
  manual
  accept
  accept_send
}

enum RegistrationStatus {
  pending
  accepted
}

enum IngestChannel {
  drive
  upload
  camera
  // Banka: created from a bank transaction ("Vytvořit doklad z platby").
  bank
}

enum BillStatus {
  new
  queued
  processing
  auto_approved
  to_review
  failed
  approved
}

enum Currency {
  CZK
  PLN
  EUR
}

enum AuditActionType {
  edit
  approve
  reopen
  // Banka: pairing with a bank transaction (docs/bank-reconciliation.md).
  bank_pair
  bank_unpair
  bank_reject
  bank_create
  bank_replace
  bank_channel
}

enum ModuleKey {
  bills
  health
  mail
  planning
  // Banka (bank reconciliation): explicit per-event grant only, admins included (src/lib/module-access.ts).
  bank
}

enum IncidentCategory {
  illness
  injury
  parasite
  medication
  other
}

enum BodyView {
  front
  back
}

enum IncidentUpdateType {
  correct
  void
}

enum ListTemplateKind {
  med
  slot
  situation
  document
  // Planning Helper (see docs/planning-helper-module-design.md)
  plan_category
  plan_location
  plan_leader
  plan_day_template
  // org base library only -- event activities live in PlanActivity
  plan_activity
}

enum ParentEmailStatus {
  sent
  failed
}

enum MailDocReceivedVia {
  email
  manual
  // System-generated (the registration-document merge on acceptance send,
  // see src/lib/document-merge.ts + src/lib/participant-document-store.ts)
  // rather than something a guardian sent in.
  generated
  // Ticked by a participant table sync (a questionnaire sheet row exists for
  // them -- ParticipantSync.markDocumentId, src/lib/participant-sync-run.ts).
  sheet
  // Uploaded by a parent in the portal instead of e-mailing it (slice 3 F;
  // only for document types with allowPortalUpload). No receiving user.
  portal
  // Matched from the organization's Fio account (docs/bank-payments-design.md).
  // No file, no receiving user.
  bank
}

enum MailActionType {
  bulk_move
  bulk_delete
  attachment_saved
  // Manual received/missing toggle on the Mail participants working list
  // (Part 2 of the participants/settings/Health/Mail prompt) -- see
  // .../participants/[participantId]/documents/[docTypeId]/route.ts.
  document_marked
  document_unmarked
}

enum MailActionStatus {
  ok
  error
}

enum UserLang {
  cs
  en
}

enum UserTheme {
  light
  dark
}

model User {
  id                 String      @id @default(uuid())
  email              String      @unique
  displayName        String
  role               UserRole
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  // Personal preferences (src/app/api/me/route.ts, src/lib/i18n.tsx) --
  // localStorage still seeds the instant paint before this loads, then
  // reconciles to these once /api/me resolves.
  preferredLang      UserLang    @default(cs) @map("preferred_lang")
  preferredTheme     UserTheme   @default(light) @map("preferred_theme")
  landingPath        String?     @map("landing_path")
  // Overrides {{sender_name}} in outgoing emails (src/lib/parent-email-send.ts,
  // src/lib/mail-bulk-status-send.ts, src/lib/participant-bulk-email.ts) --
  // an Outlook-signature-style personal setting, falling back to
  // displayName when unset.
  emailSignature     String?     @map("email_signature")
  // Multi-line signature for the e-mail TEXT, {{signature}} in templates
  // (falls back to the name above) -- see senderIdentity() in src/lib/email-template.ts.
  emailBodySignature String?     @map("email_body_signature")
  // Second settings layer: modules a person has chosen to hide from their own
  // sidebar. Admin decides what they *have* (UserEventModuleAccess); this only
  // narrows their own view, never grants anything.
  hiddenModules      ModuleKey[] @default([]) @map("hidden_modules")
  // Small per-person UI preferences that should follow the user across
  // devices (see src/lib/ui-prefs.ts for the allowed keys).
  uiPrefs            Json?       @map("ui_prefs")

  moduleAccess           UserEventModuleAccess[]
  driveAccount           DriveAccount?           @relation("DriveAccountConnectedBy")
  eventsDriveConfigured  Event[]                 @relation("EventDriveConfiguredBy")
  authorBankAudits       AuthorBankAudit[]       @relation("AuthorBankAuditChangedBy")
  billsCreated           Bill[]                  @relation("BillCreatedBy")
  billsApproved          Bill[]                  @relation("BillApprovedBy")
  billsPaid              Bill[]                  @relation("BillPaidBy")
  auditLogEntries        BillAuditLog[]
  incidentsCreated       Incident[]              @relation("IncidentCreatedBy")
  incidentUpdates        IncidentUpdate[]        @relation("IncidentUpdatedBy")
  medChecklistGiven      MedChecklist[]          @relation("MedChecklistGivenBy")
  parentEmailsSent       ParentEmailLog[]        @relation("ParentEmailSentBy")
  mailAccountsConnected  MailSenderAccount[]     @relation("MailAccountConnectedBy")
  documentsReceived      ParticipantDocument[]   @relation("ParticipantDocumentReceivedBy")
  mailActionsPerformed   MailActionLog[]         @relation("MailActionLogUser")
  childChangesDecided    ChildChange[]           @relation("ChildChangeDecidedBy")
  documentsReviewed      ParticipantDocument[]   @relation("ParticipantDocumentReviewedBy")
  personDocumentsCreated PersonDocument[]        @relation("PersonDocumentCreatedBy")
  personDocumentsRevoked PersonDocument[]        @relation("PersonDocumentRevokedBy")
  childEmailsSent        ChildEmailLog[]         @relation("ChildEmailSentBy")
  bankTokensSet          BankAccount[]           @relation("BankAccountTokenSetBy")
  bankMovementsDecided   BankMovement[]          @relation("BankMovementDecidedBy")

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Sees and manages every organization (organizations step 2+).
  isSuperAdmin   Boolean      @default(false) @map("is_super_admin")

  @@index([organizationId])
  @@map("users")
}

model Module {
  key  ModuleKey @id
  name String

  @@map("modules")
}

model EventModule {
  eventId   String    @map("event_id")
  moduleKey ModuleKey @map("module_key")
  enabled   Boolean   @default(false)

  event Event @relation(fields: [eventId], references: [id])

  @@id([eventId, moduleKey])
  @@map("event_modules")
}

model UserEventModuleAccess {
  userId    String    @map("user_id")
  eventId   String    @map("event_id")
  moduleKey ModuleKey @map("module_key")

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@id([userId, eventId, moduleKey])
  @@map("user_event_module_access")
}

model Event {
  id                            String         @id @default(uuid())
  name                          String
  startDate                     DateTime       @map("start_date") @db.Date
  endDate                       DateTime       @map("end_date") @db.Date
  status                        EventStatus    @default(active)
  driveIngestFolderId           String?        @map("drive_ingest_folder_id")
  driveExportFolderId           String?        @map("drive_export_folder_id")
  driveManifestSpreadsheetId    String?        @map("drive_manifest_spreadsheet_id")
  // Where per-participant folders (registration documents, received/generated
  // files) live -- separate from the bills export folder above. Null falls
  // back to driveExportFolderId (the old shared behavior).
  driveParticipantsFolderId     String?        @map("drive_participants_folder_id")
  // Zpracované soubory: Drive import moves imported files here (src/lib/drive-import.ts); the
  // "Úklid souborů na Disku" tool's default target.
  driveProcessedFolderId        String?        @map("drive_processed_folder_id")
  // The user whose connected Google account does this event's Drive work (see
  // DriveAccount). Set when someone saves the event's Drive folders, when a user
  // connects from the Drive tab and none is set, or via "take over".
  driveConfiguredByUserId       String?        @map("drive_configured_by_user_id")
  senderEmail                   String?        @map("sender_email")
  driveDocSyncEnabled           Boolean        @default(true) @map("drive_doc_sync_enabled")
  statusExportEnabled           Boolean        @default(true) @map("status_export_enabled")
  statusExportSheetId           String?        @map("status_export_sheet_id")
  statusExportLastSyncedAt      DateTime?      @map("status_export_last_synced_at")
  mailDoneLabelName             String?        @map("mail_done_label_name")
  mailQuestionnaireUrl          String?        @map("mail_questionnaire_url")
  // Optional -- {{registration_deadline}} (Part 11 of the participants/settings
  // prompt). Omitted (not defaulted to a hardcoded date) when null, so the
  // acceptance e-mail/document sentence that uses it is simply left out instead
  // of ever printing a wrong or contradicting date.
  registrationDeadline          DateTime?      @map("registration_deadline") @db.Date
  // Persisted registration-sheet connection (Seznam účastníků import
  // settings) -- set once, reused on every future import instead of
  // re-pasting the sheet id and remapping columns each time. Mapping is
  // stored keyed by header name (not column index), since sheet columns can
  // be reordered between imports; unrecognized headers fall back to the
  // same guess-from-header-text heuristic as before.
  participantsSheetId           String?        @map("participants_sheet_id")
  participantsColumnMapping     Json?          @map("participants_column_mapping")
  // Participant table connections (src/lib/participant-sync.ts ParticipantSync[]);
  // the two columns above are the old single connection, converted on first read.
  participantSyncs              Json?          @map("participant_syncs")
  // Camp-fee collection, used by the registration-document merge (price +
  // QR payment code) -- deliberately separate from any bill/reimbursement
  // bank account elsewhere in the app; this is the org's own fee account.
  memberPriceCzk                Int?           @map("member_price_czk")
  nonMemberPriceCzk             Int?           @map("non_member_price_czk")
  registrationBankAccountNumber String?        @map("registration_bank_account_number")
  registrationBankCode          String?        @map("registration_bank_code")
  // Variable-symbol formula config (computed field, see
  // src/lib/document-variables.ts's buildVariableSymbol): year comes from
  // startDate, vsEventType/vsOrderInYear are admin-typed single digits,
  // vsMembershipFieldKey names the boolean custom field whose "true" value
  // sets the membership digit to 1 (else 0). Null vsMembershipFieldKey means
  // no membership digit is configured -- always 0.
  // Two-digit year override (e.g. 27 for a registration run in 2026 for
  // next year); null = from startDate.
  vsYear                        Int?           @map("vs_year")
  vsEventType                   Int?           @map("vs_event_type")
  vsOrderInYear                 Int?           @map("vs_order_in_year")
  // Values of the membership field that mean "member" (lower-cased); null =
  // DEFAULT_MEMBER_VALUES in src/lib/document-variables.ts.
  vsMemberValues                Json?          @map("vs_member_values")
  vsMembershipFieldKey          String?        @map("vs_membership_field_key")
  // Side length (mm) of the payment QR image inserted into documents. Null
  // means the default (DEFAULT_QR_SIZE_MM in src/lib/document-variables.ts).
  qrSizeMm                      Int?           @map("qr_size_mm")
  // Ordered EventParticipantField keys chosen for the central roster's
  // columns (Name is always first and isn't included here). Null means not
  // configured yet -- falls back to every active field with the `list`
  // surface, in API order (the old, always-on behavior).
  participantsListColumns       Json?          @map("participants_list_columns")
  // Ordered column keys chosen for the bills list (src/lib/bill-columns.ts). Stored per
  // event, so everyone with access sees the same columns; null = the default set.
  // (A Json array like participantsListColumns -- Prisma has no nullable scalar list.)
  billsListColumns              Json?          @map("bills_list_columns")
  // Ordered participant-field keys shown as columns in the Documents overview
  // (mail_list fields); null = all of them. Saved via /mail/sync-settings.
  documentsListColumns          Json?          @map("documents_list_columns")
  // Optional field columns of the Zdraví list (ordered keys); null = none.
  healthListColumns             Json?          @map("health_list_columns")
  // Planning Helper settings (src/lib/planning.ts PlanningSettings): saved
  // import sheet connections per import target, and the Drive export sheet id.
  planningSettings              Json?          @map("planning_settings")
  // Zdravotní poznámky config (src/lib/health-notes.ts HealthNoteConfig[]):
  // which fields, in what order, where shown, highlighted. null = default.
  healthNotes                   Json?          @map("health_notes")
  // Participant detail / Zdraví detail layouts (src/lib/participant-layout.ts
  // ParticipantLayout: { detail?, health? }). null = the built-in layout.
  participantLayout             Json?          @map("participant_layout")
  // Registration & membership (docs/registration-membership.md). All off by
  // default: an unconnected event behaves exactly as before.
  kind                          EventKind      @default(event)
  // Only for kind = membership: the calendar year the membership counts for.
  membershipYear                Int?           @map("membership_year")
  // On: participants get linked to Child profiles, and member pricing reads
  // the child's accepted membership for the event's start year.
  registrationConnected         Boolean        @default(false) @map("registration_connected")
  // "Odpojit od Lidé": this event's participants are unlinked from the people
  // list and never linked again (not even by Lidé's "Propojit"), until reconnected.
  peopleUnlinked                Boolean        @default(false) @map("people_unlinked")
  // Slice 8 #3: which participants auto-linking may link -- `all` (today:
  // everyone, creating missing people) or `existing` (only to people already
  // in Lidé, never creating one). src/lib/children.ts linkChildren.
  peopleLinkMode                PeopleLinkMode @default(all) @map("people_link_mode")
  // Parent portal (docs/registration-portal-spec.md H): "Otevřeno pro přihlášky
  // v portálu" -- only used when the event is connected (or a membership year),
  // hidden after registrationDeadline. eligibility = src/lib/portal-rules.ts
  // Eligibility ({ everyone?, birthYearFrom?, birthYearTo?, groups?,
  // attendedEventIds?, childIds? }); null/empty = nobody.
  portalOpen                    Boolean        @default(false) @map("portal_open")
  eligibility                   Json?
  // Price rules (docs/registration-slice3-spec.md C, src/lib/price-rules.ts
  // PriceRules: categories, school-year date, household minimum). null =
  // today's pricing exactly (memberPriceCzk / nonMemberPriceCzk by isMember).
  priceRules                    Json?          @map("price_rules")
  // Public registration page /r/<publicSlug> (docs/registration-slice3-spec.md
  // D): landing info (markdown) + the new-family form. Off by default; only
  // used for a membership year or a connected event.
  publicRegistration            Boolean        @default(false) @map("public_registration")
  publicSlug                    String?        @unique @map("public_slug")
  landingContent                String?        @map("landing_content")
  autoAccept                    AutoAccept     @default(manual) @map("auto_accept")
  // Shown on the portal's registration card (slice 3 F): place + a short info.
  location                      String?
  portalInfo                    String?        @map("portal_info")
  // "Dokument platby" (slice 4 #5): the document type (EventListItem id) whose
  // receipt means "paid" in the portal; never uploadable there. null = none.
  paymentDocTypeId              String?        @map("payment_doc_type_id")
  // Bills manifest category layout (src/lib/manifest.ts): "pairs" (null, Kategorie n + Částka n)
  // or "columns" (one column per category, named by it, amounts only).
  manifestCategoryMode          String?        @map("manifest_category_mode")
  // Automatic payment check (docs/bank-payments-design.md): settled bank
  // movements on this account create the paymentDocTypeId document.
  bankCheckEnabled              Boolean        @default(false) @map("bank_check_enabled")
  bankAccountId                 String?        @map("bank_account_id")
  bankAccount                   BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  createdAt                     DateTime       @default(now()) @map("created_at")
  closedAt                      DateTime?      @map("closed_at")

  categories             EventCategory[]
  modules                EventModule[]
  moduleAccess           UserEventModuleAccess[]
  authorAccess           AuthorEventAccess[]
  authorBankAudits       AuthorBankAudit[]
  driveConfiguredBy      User?                   @relation("EventDriveConfiguredBy", fields: [driveConfiguredByUserId], references: [id])
  bills                  Bill[]
  participants           Participant[]
  eventListItems         EventListItem[]
  personDocuments        PersonDocument[]
  eventEmailTemplates    EventEmailTemplate[]
  mailActionLogs         MailActionLog[]
  eventParticipantFields EventParticipantField[]
  planDays               PlanDay[]
  planActivities         PlanActivity[]
  publicHosts            PublicHost[]
  deposits               EventDeposit[]
  aiUsage                AiUsage[]
  bankLinks              EventBankAccount[]
  bankTransactions       BankTransaction[]
  bankImportBatches      BankImportBatch[]

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("events")
}

model CategoryTemplate {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Owner (docs/organizations-change-notes.md).
  organizationId   String?            @map("organization_id")
  organization     Organization?      @relation(fields: [organizationId], references: [id])
  // The template this one was copied from (organizations step 4); unused for now.
  sourceTemplateId String?            @map("source_template_id")
  sourceTemplate   CategoryTemplate?  @relation("CategoryTemplateSource", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies           CategoryTemplate[] @relation("CategoryTemplateSource")

  // Per organization; NULL (app level) counts as one group: NULLS NOT DISTINCT in the migration SQL.
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("category_templates")
}

model EventCategory {
  id                 String  @id @default(uuid())
  eventId            String  @map("event_id")
  name               String
  description        String?
  budgetAmount       Decimal @map("budget_amount") @db.Decimal(12, 2)
  isFromTemplate     Boolean @default(false) @map("is_from_template")
  // The CategoryTemplate it was copied from -- sync matches by this, so a
  // category renamed for this event isn't copied from the template again.
  categoryTemplateId String? @map("category_template_id")

  event          Event          @relation(fields: [eventId], references: [id])
  billCategories BillCategory[]

  @@map("event_categories")
}

model Author {
  id                 String   @id @default(uuid())
  canonicalName      String   @map("canonical_name")
  bankAccountNumber  String?  @map("bank_account_number")
  bankCode           String?  @map("bank_code")
  mergedIntoAuthorId String?  @map("merged_into_author_id")
  active             Boolean  @default(true)
  // The organization's official bank account (bills it paid = spent directly by the organization,
  // never paid out; manifest summary / budget settlement). Implies payoutNeeded = false.
  isOfficialAccount  Boolean  @default(false) @map("is_official_account")
  // false = nobody is paid out for this payer's bills (like "Akce"): no "Proplaceno" to track.
  payoutNeeded       Boolean  @default(true) @map("payout_needed")
  createdAt          DateTime @default(now()) @map("created_at")

  mergedInto  Author?             @relation("AuthorMerge", fields: [mergedIntoAuthorId], references: [id])
  mergedFrom  Author[]            @relation("AuthorMerge")
  eventAccess AuthorEventAccess[]
  bills       Bill[]
  bankAudits  AuthorBankAudit[]

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("authors")
}

enum AuthorBankAuditSource {
  event_edit
  admin_edit
  merge
  create
  import
}

// Every change of a payer's bank account/code (who, when, old -> new, and
// which event it was made from). Written in the same transaction as the change.
model AuthorBankAudit {
  id                   String                @id @default(uuid())
  authorId             String                @map("author_id")
  changedByUserId      String                @map("changed_by_user_id")
  eventId              String?               @map("event_id")
  oldBankAccountNumber String?               @map("old_bank_account_number")
  oldBankCode          String?               @map("old_bank_code")
  newBankAccountNumber String?               @map("new_bank_account_number")
  newBankCode          String?               @map("new_bank_code")
  source               AuthorBankAuditSource
  createdAt            DateTime              @default(now()) @map("created_at")

  author        Author @relation(fields: [authorId], references: [id])
  changedByUser User   @relation("AuthorBankAuditChangedBy", fields: [changedByUserId], references: [id])
  event         Event? @relation(fields: [eventId], references: [id])

  @@index([authorId, createdAt])
  @@map("author_bank_audit")
}

model AuthorEventAccess {
  authorId String @map("author_id")
  eventId  String @map("event_id")

  author Author @relation(fields: [authorId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])

  @@id([authorId, eventId])
  @@map("author_event_access")
}

model Translation {
  key String @id
  cs  String
  en  String

  @@map("translations")
}

model Bill {
  id                         String              @id @default(uuid())
  eventId                    String              @map("event_id")
  // null = no file yet ("Vytvořit doklad z platby", documentMissing).
  gcsObjectPath              String?             @map("gcs_object_path")
  originalGcsObjectPath      String?             @map("original_gcs_object_path")
  // Bill: current file + the kept original (originalGcsObjectPath) together.
  // Stored bytes in GCS (usage metering, /vyuziti); null = not measured yet (scripts/backfill-gcs-sizes.ts).
  sizeBytes                  BigInt?             @map("size_bytes")
  // Banka (docs/bank-reconciliation.md): paid in cash / from another account, set by hand;
  // a confirmed bank pair wins over it (src/lib/bank/payment-state.ts).
  paymentChannel             BillPaymentChannel? @map("payment_channel")
  paymentNote                String?             @map("payment_note")
  // Created from a bank transaction without a document / the bank statement is the document.
  documentMissing            Boolean             @default(false) @map("document_missing")
  documentFromStatement      Boolean             @default(false) @map("document_from_statement")
  missingDocAssigneeAuthorId String?             @map("missing_doc_assignee_author_id")
  originalFilename           String              @map("original_filename")
  displayFilename            String?             @map("display_filename")
  driveSourceFileId          String?             @map("drive_source_file_id")
  contentHash                String              @map("content_hash")
  ingestChannel              IngestChannel       @map("ingest_channel")
  merchantName               String?             @map("merchant_name")
  billDate                   DateTime?           @map("bill_date") @db.Date
  totalAmount                Decimal?            @map("total_amount") @db.Decimal(12, 2)
  currency                   Currency            @default(CZK)
  amountCzk                  Decimal?            @map("amount_czk") @db.Decimal(12, 2)
  exchangeRateUsed           Decimal?            @map("exchange_rate_used") @db.Decimal(12, 6)
  exchangeRateDate           DateTime?           @map("exchange_rate_date") @db.Date
  payerAuthorId              String?             @map("payer_author_id")
  pendingCategoryId          String?             @map("pending_category_id")
  paidToAuthor               Boolean             @default(false) @map("paid_to_author")
  paidAt                     DateTime?           @map("paid_at")
  paidByUserId               String?             @map("paid_by_user_id")
  status                     BillStatus          @default(new)
  notes                      String?
  aiConfidence               Decimal?            @map("ai_confidence") @db.Decimal(5, 4)
  aiRawResponse              Json?               @map("ai_raw_response")
  createdByUserId            String              @map("created_by_user_id")
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @default(now()) @updatedAt @map("updated_at")
  approvedAt                 DateTime?           @map("approved_at")
  approvedByUserId           String?             @map("approved_by_user_id")
  exportedAt                 DateTime?           @map("exported_at")
  exportFilename             String?             @map("export_filename")

  event       Event                    @relation(fields: [eventId], references: [id])
  payerAuthor Author?                  @relation(fields: [payerAuthorId], references: [id])
  createdBy   User                     @relation("BillCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy  User?                    @relation("BillApprovedBy", fields: [approvedByUserId], references: [id])
  paidBy      User?                    @relation("BillPaidBy", fields: [paidByUserId], references: [id])
  categories  BillCategory[]
  bankMatches BankMatch[]
  dupDismissA BillDuplicateDismissal[] @relation("DupDismissA")
  dupDismissB BillDuplicateDismissal[] @relation("DupDismissB")
  auditLog    BillAuditLog[]

  @@unique([eventId, contentHash], name: "bills_event_content_hash_unique")
  @@map("bills")
}

model BillCategory {
  id              String   @id @default(uuid())
  billId          String   @map("bill_id")
  eventCategoryId String   @map("event_category_id")
  amount          Decimal  @db.Decimal(12, 2)
  amountCzk       Decimal? @map("amount_czk") @db.Decimal(12, 2)

  bill          Bill          @relation(fields: [billId], references: [id])
  eventCategory EventCategory @relation(fields: [eventCategoryId], references: [id])

  @@map("bill_categories")
}

model BillAuditLog {
  id         String          @id @default(uuid())
  billId     String          @map("bill_id")
  userId     String          @map("user_id")
  actionType AuditActionType @map("action_type")
  fieldName  String?         @map("field_name")
  oldValue   String?         @map("old_value")
  newValue   String?         @map("new_value")
  changedAt  DateTime        @default(now()) @map("changed_at")

  bill Bill @relation(fields: [billId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("bill_audit_log")
}

model ExchangeRate {
  id        String   @id @default(uuid())
  currency  Currency
  rateDate  DateTime @map("rate_date") @db.Date
  rateToCzk Decimal  @map("rate_to_czk") @db.Decimal(16, 6)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([currency, rateDate])
  @@map("exchange_rates")
}

model MerchantAlias {
  id            String   @id @default(uuid())
  rawText       String   @map("raw_text")
  canonicalName String   @map("canonical_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, rawText])
  @@index([organizationId])
  @@map("merchant_aliases")
}

// ---------------------------------------------------------------------------
// Health module
// ---------------------------------------------------------------------------

model Participant {
  id                     String             @id @default(uuid())
  eventId                String             @map("event_id")
  // `name` is kept as the maintained full display name ("Jméno Příjmení",
  // written from firstName+lastName on every save) so existing readers
  // (search, sort, exports, {{Name}}) keep working unchanged -- see
  // src/lib/participant-name.ts. firstName/lastName are null for rows not
  // yet migrated (scripts/split-participant-names.ts) or left ambiguous.
  name                   String
  firstName              String?            @map("first_name")
  lastName               String?            @map("last_name")
  groupName              String?            @map("group_name")
  dateOfBirth            DateTime?          @map("date_of_birth") @db.Date
  active                 Boolean            @default(true)
  registrationStatus     RegistrationStatus @default(pending) @map("registration_status")
  // Admin-defined participant fields (address, health insurance, camp-fee
  // membership, etc.) -- Record<fieldKey, string>, keyed by
  // EventParticipantField.key. Not a fixed set of columns: which fields
  // exist, their type, and which screens show them are all admin-editable
  // (see ParticipantFieldTemplate/EventParticipantField below and
  // src/lib/document-variables.ts's participant_custom_field resolver).
  customFieldValues      Json?              @map("custom_field_values")
  // Camp-fee variable symbol -- assigned once, at acceptance (see
  // src/lib/document-variables.ts), stable afterwards. Null until accepted.
  registrationNumber     Int?               @map("registration_number")
  // The persistent child profile this event's row belongs to (null = not
  // linked; everything works as before). See src/lib/children.ts.
  childId                String?            @map("child_id")
  // Optional note a parent typed when registering through the portal.
  portalNote             String?            @map("portal_note")
  // Price category key (Event.priceRules); null/unknown = the first category
  // allowed for the person. Unused while the event has no price rules.
  priceCategory          String?            @map("price_category")
  // The price the last acceptance e-mail carried -- the roster flags a live
  // price that differs from it ("cena se změnila po odeslání").
  acceptedPriceCzk       Int?               @map("accepted_price_czk")
  // The variable symbol the same acceptance e-mail carried -- the bank check
  // matches on it as well as on the current one.
  acceptedVariableSymbol String?            @map("accepted_variable_symbol")
  createdAt              DateTime           @default(now()) @map("created_at")

  event          Event                 @relation(fields: [eventId], references: [id])
  child          Child?                @relation(fields: [childId], references: [id])
  guardians      ParticipantGuardian[]
  incidents      Incident[]
  medPlans       ParticipantMedPlan[]
  medChecklist   MedChecklist[]
  emailLogs      ParentEmailLog[]
  documents      ParticipantDocument[]
  mailActionLogs MailActionLog[]
  bankMovements  BankMovement[]

  @@unique([eventId, registrationNumber])
  @@index([childId])
  @@map("participants")
}

// One child across all events and years: identity (name + birth date, what
// linking matches on) plus the profile (src/lib/child-profile.ts) -- the
// org-wide field values and guardians, copied once from the latest
// participation and pushed to upcoming connected events on every change.
model Child {
  id                    String         @id @default(uuid())
  name                  String
  firstName             String?        @map("first_name")
  lastName              String?        @map("last_name")
  dateOfBirth           DateTime?      @map("date_of_birth") @db.Date
  // Record<ParticipantFieldTemplate.key, string> -- same keys/values as
  // Participant.customFieldValues.
  fieldValues           Json?          @map("field_values")
  // Parent portal link (/p/<token>): random, generated on demand; replacing it
  // kills the old link and every device's birth-date cookie (src/lib/portal-gate.ts).
  portalToken           String?        @unique @map("portal_token")
  // Wrong birth-date attempts in the current one-hour window (throttle).
  portalGateFailures    Int            @default(0) @map("portal_gate_failures")
  portalGateWindowStart DateTime?      @map("portal_gate_window_start")
  // Slice 3 (docs/registration-slice3-spec.md A): members are people -- an
  // adult member (leader, supporter) is a Child row with isAdult on (the table
  // keeps its name, no destructive rename). An adult's own contact is their
  // first guardian row (same e-mail = same person in the family view).
  isAdult               Boolean        @default(false) @map("is_adult")
  // The household this person belongs to (at most one); null = none. Families
  // are only ever made by an admin's confirm (or the public form, flagged for review).
  familyId              String?        @map("family_id")
  // "Už nebude chodit" (docs/registration-slice8-spec.md #2): inactive since
  // leftAt (null = active), marked in the portal or by an admin. Nothing is
  // deleted; the portal won't register an inactive person and link e-mails skip them.
  leftAt                DateTime?      @map("left_at")
  leftNote              String?        @map("left_note")
  leftVia               PersonLeftVia? @map("left_via")
  createdAt             DateTime       @default(now()) @map("created_at")

  family       Family?          @relation(fields: [familyId], references: [id], onDelete: SetNull)
  participants Participant[]
  guardians    ChildGuardian[]
  changes      ChildChange[]
  emailLogs    ChildEmailLog[]
  documents    PersonDocument[]

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([familyId])
  @@map("children")
}

enum PeopleLinkMode {
  all
  existing
}

enum PersonLeftVia {
  portal
  admin
}

// Attempts counted for the public pages' rate limits (slice 3 D/F): key =
// "submit:<hashed IP>" (public form), "resend:<participantId>" (portal
// re-send), "upload:<participantId>" (portal upload). Old rows are pruned.
model PortalRateHit {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("portal_rate_hits")
}

// A household (docs/registration-slice3-spec.md B), e.g. "Novákovi": one
// portal link /p/<portalToken> for every member. Same token + birth-date gate
// rules as a child's link (any member's birth date passes; the cookie is
// scoped to the family + current token, src/lib/portal-gate.ts).
model Family {
  id                    String    @id @default(uuid())
  name                  String
  portalToken           String?   @unique @map("portal_token")
  portalGateFailures    Int       @default(0) @map("portal_gate_failures")
  portalGateWindowStart DateTime? @map("portal_gate_window_start")
  // Made by the public registration form: shown under "Ke kontrole" on the
  // Lidé page (possible duplicates are never merged automatically).
  needsReview           Boolean   @default(false) @map("needs_review")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  members Child[]

  // Owner (docs/organizations-change-notes.md).
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("families")
}

// Mirrors ParticipantGuardian, on the child profile.
model ChildGuardian {
  id                     String  @id @default(uuid())
  childId                String  @map("child_id")
  name                   String?
  email                  String
  relationship           String?
  phone                  String?
  receivesCommunications Boolean @default(true) @map("receives_communications")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("child_guardians")
}

// Per org-wide field: what a parent may do with it in the portal. hidden (the
// default) = not even sent to the portal.
enum PortalAccess {
  edit
  approval
  read
  hidden
}

enum ChildChangeStatus {
  pending
  accepted
  rejected
}

// A parent's portal edit of an `approval` field, waiting for an admin. While
// pending the old value stays live everywhere. fieldKey = a
// ParticipantFieldTemplate key or a built-in (participant_first_name,
// participant_last_name, datum_narozeni). One pending row per child + field: a
// newer edit replaces it.
model ChildChange {
  id          String            @id @default(uuid())
  childId     String            @map("child_id")
  fieldKey    String            @map("field_key")
  oldValue    String?           @map("old_value")
  newValue    String?           @map("new_value")
  status      ChildChangeStatus @default(pending)
  createdAt   DateTime          @default(now()) @map("created_at")
  decidedById String?           @map("decided_by_id")
  decidedAt   DateTime?         @map("decided_at")

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("ChildChangeDecidedBy", fields: [decidedById], references: [id])

  @@index([childId, status])
  @@map("child_changes")
}

// Child-level e-mails (the portal link) -- ParentEmailLog needs a participant,
// these have none. One row per recipient attempt.
model ChildEmailLog {
  id           String            @id @default(uuid())
  childId      String            @map("child_id")
  email        String
  purposeKey   String            @map("purpose_key")
  sentAt       DateTime          @default(now()) @map("sent_at")
  status       ParentEmailStatus
  errorMessage String?           @map("error_message")
  sentByUserId String            @map("sent_by_user_id")
  subject      String?

  child  Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  sentBy User  @relation("ChildEmailSentBy", fields: [sentByUserId], references: [id])

  @@index([childId])
  @@map("child_email_log")
}

model ParticipantGuardian {
  id                     String  @id @default(uuid())
  participantId          String  @map("participant_id")
  name                   String?
  email                  String
  relationship           String?
  phone                  String?
  receivesCommunications Boolean @default(true) @map("receives_communications")

  participant Participant      @relation(fields: [participantId], references: [id])
  emailLogs   ParentEmailLog[]

  @@map("participant_guardians")
}

enum ParticipantFieldType {
  text
  number
  date
  boolean
  select
  image
  // Computed from other fields joined by a separator (e.g. full address);
  // options = { parts: fieldKey[], separator } -- never stored per participant.
  composite
}

// Deliberately distinct from ModuleKey -- "list" (the central Seznam
// účastníků roster) isn't an access-controlled module, it's a display
// surface within the roster. A genuinely new module gets a new surface
// value here the same way ModuleKey itself grows when a module ships.
// `documents` and `import` were folded in from the old standalone
// MergeVariable/"Include in documents" mechanism and the participant-import
// screen's hardcoded target list -- both are now just more surfaces a field
// can be flagged for, same UI as the display surfaces. They're a11y-neutral
// to module gating (see allowedParticipantFieldKeys) since a field can be
// document-mergeable regardless of which module it's otherwise scoped to.
enum ParticipantFieldSurface {
  list // Seznam účastníků (central roster) columns
  health_list // Zdraví page columns
  health_detail // Zdraví participant detail page fields
  mail_list // Mail participants page columns
  documents // usable as {{key}} in document merge
  email // usable as {{key}} in e-mail templates (split from documents)
  import // offered as a target column when importing participants
}

// Which participant-connected thing a field actually is. `custom` is the
// only kind ParticipantFieldTemplate ever holds (org-wide admin-defined
// fields); `builtin`/`guardian`/`computed` only ever exist as fixed,
// non-deletable EventParticipantField rows seeded per event (see
// src/lib/participant-field-seed.ts's seedFixedParticipantFields) so their
// surfaces are configurable from the same admin screen as custom fields,
// without a template layer that makes no sense for a field type can't add
// or remove.
enum ParticipantFieldKind {
  custom
  builtin
  guardian
  computed
}

// Only set when kind = computed -- which fixed formula resolves the value.
// A new computed type needs a code change in src/lib/document-variables.ts
// regardless (the formula itself can't be admin-authored), this just says
// which one a given fixed row maps to.
enum ComputedFieldType {
  effective_price
  variable_symbol
  payment_qr_image
  // First guardian with receivesCommunications = true, else the first
  // guardian -- see resolveContactEmail() in document-variables.ts.
  contact_email
}

// Org-wide field definition, synced into EventParticipantField the same
// way CategoryTemplate syncs into EventCategory (see
// src/app/api/events/[id]/participant-fields/sync/route.ts). `key` is the
// stable {{key}} used both in customFieldValues and, once its `documents`
// surface is on, in document templates -- immutable after creation.
model ParticipantFieldTemplate {
  // Organizations step 4: id is the key; `key` is unique per organization (NULL = app level, one group).
  id                     String                    @id @default(uuid())
  key                    String
  label                  String
  fieldType              ParticipantFieldType      @map("field_type")
  options                Json?
  // Suggested surfaces applied when this template is synced into an event
  // (manually, at event creation, or when a module the surfaces belong to
  // gets enabled -- see .../participant-fields/sync/route.ts and the
  // modules PATCH route's enable hook).
  defaultSurfaces        ParticipantFieldSurface[] @map("default_surfaces")
  active                 Boolean                   @default(true)
  // Parent portal rule for this field (child profiles, docs/registration-portal-spec.md C).
  portalAccess           PortalAccess              @default(hidden) @map("portal_access")
  // Must be filled in the public registration form (slice 3 D); only for
  // fields the form shows (portalAccess != hidden).
  requiredInRegistration Boolean                   @default(false) @map("required_in_registration")
  // Slice 5 (docs/registration-slice5-spec.md 1): who the field applies to
  // (children / adult members / both) and whether the profile asks it up
  // front (basic) or only when an event needs it (detailed).
  audience               FieldAudience             @default(both)
  level                  FieldLevel                @default(basic)

  // Owner (docs/organizations-change-notes.md).
  organizationId   String?                    @map("organization_id")
  organization     Organization?              @relation(fields: [organizationId], references: [id])
  // The app template this one was copied from.
  sourceTemplateId String?                    @map("source_template_id")
  sourceTemplate   ParticipantFieldTemplate?  @relation("ParticipantFieldTemplateSource", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies           ParticipantFieldTemplate[] @relation("ParticipantFieldTemplateSource")

  // Per organization; NULL (app level) counts as one group: NULLS NOT DISTINCT in the migration SQL.
  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("participant_field_templates")
}

enum FieldAudience {
  both
  children
  adults
}

enum FieldLevel {
  basic
  detailed
}

model EventParticipantField {
  id                     String                    @id @default(uuid())
  eventId                String                    @map("event_id")
  key                    String
  label                  String
  fieldType              ParticipantFieldType      @map("field_type")
  options                Json?
  surfaces               ParticipantFieldSurface[]
  sortOrder              Int?                      @map("sort_order")
  active                 Boolean                   @default(true)
  isFromTemplate         Boolean                   @default(false) @map("is_from_template")
  // custom rows (the default) are fully admin-managed, same as before.
  // builtin/guardian/computed rows are fixed system rows seeded per event --
  // their key/fieldType/kind/computedType aren't editable, only surfaces/active.
  kind                   ParticipantFieldKind      @default(custom)
  computedType           ComputedFieldType?        @map("computed_type")
  // "Vyžadovat při přihlášce" (slice 5 #2): asked in the registration step. A
  // field with an org template only while parents may edit it (edit/approval);
  // an event-only field is an event question, stored on the participant only.
  requiredOnRegistration Boolean                   @default(false) @map("required_on_registration")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, key])
  @@map("event_participant_fields")
}

model Incident {
  id               String           @id @default(uuid())
  participantId    String           @map("participant_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  createdByUserId  String           @map("created_by_user_id")
  category         IncidentCategory
  templateType     String?          @map("template_type")
  incidentDate     DateTime         @default(now()) @map("incident_date") @db.Date
  incidentTime     String?          @map("incident_time")
  actionSummary    String           @map("action_summary")
  pillName         String?          @map("pill_name")
  details          String?
  photoGcsPath     String?          @map("photo_gcs_path")
  // Stored bytes in GCS (usage metering, /vyuziti); null = not measured yet (scripts/backfill-gcs-sizes.ts).
  sizeBytes        BigInt?          @map("size_bytes")
  parentIncidentId String?          @map("parent_incident_id")
  tempC            Decimal?         @map("temp_c") @db.Decimal(4, 1)
  bodyView         BodyView?        @map("body_view")
  bodyXPct         Decimal?         @map("body_x_pct") @db.Decimal(5, 2)
  bodyYPct         Decimal?         @map("body_y_pct") @db.Decimal(5, 2)

  participant    Participant      @relation(fields: [participantId], references: [id])
  createdBy      User             @relation("IncidentCreatedBy", fields: [createdByUserId], references: [id])
  parentIncident Incident?        @relation("IncidentFollowUp", fields: [parentIncidentId], references: [id])
  followUps      Incident[]       @relation("IncidentFollowUp")
  updates        IncidentUpdate[]

  @@map("incidents")
}

model IncidentUpdate {
  id              String             @id @default(uuid())
  incidentId      String             @map("incident_id")
  updatedAt       DateTime           @default(now()) @map("updated_at")
  updatedByUserId String             @map("updated_by_user_id")
  updateType      IncidentUpdateType @map("update_type")
  incidentDate    DateTime           @map("incident_date") @db.Date
  incidentTime    String?            @map("incident_time")
  actionSummary   String             @map("action_summary")
  pillName        String?            @map("pill_name")
  details         String?
  photoGcsPath    String?            @map("photo_gcs_path")
  // Stored bytes in GCS (usage metering, /vyuziti); null = not measured yet (scripts/backfill-gcs-sizes.ts).
  sizeBytes       BigInt?            @map("size_bytes")
  tempC           Decimal?           @map("temp_c") @db.Decimal(4, 1)
  bodyView        BodyView?          @map("body_view")
  bodyXPct        Decimal?           @map("body_x_pct") @db.Decimal(5, 2)
  bodyYPct        Decimal?           @map("body_y_pct") @db.Decimal(5, 2)
  note            String?

  incident  Incident @relation(fields: [incidentId], references: [id])
  updatedBy User     @relation("IncidentUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("incident_updates")
}

// Generic org-default -> per-event-copy template mechanism, shared by meds,
// meds time slots, and situation templates (see design doc "Build note").
model ListTemplate {
  id        String           @id @default(uuid())
  kind      ListTemplateKind
  key       String?
  name      String
  sortOrder Int?             @map("sort_order")
  active    Boolean          @default(true)
  data      Json?

  // Owner (docs/organizations-change-notes.md).
  organizationId   String?        @map("organization_id")
  organization     Organization?  @relation(fields: [organizationId], references: [id])
  // The template this one was copied from (organizations step 4); unused for now.
  sourceTemplateId String?        @map("source_template_id")
  sourceTemplate   ListTemplate?  @relation("ListTemplateSource", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies           ListTemplate[] @relation("ListTemplateSource")

  @@index([organizationId])
  @@map("list_templates")
}

model EventListItem {
  id             String           @id @default(uuid())
  eventId        String           @map("event_id")
  kind           ListTemplateKind
  key            String?
  name           String
  sortOrder      Int?             @map("sort_order")
  active         Boolean          @default(true)
  isFromTemplate Boolean          @default(false) @map("is_from_template")
  data           Json?

  event                    Event                 @relation(fields: [eventId], references: [id])
  medPlansAsMed            ParticipantMedPlan[]  @relation("MedPlanMed")
  medPlansAsSlot           ParticipantMedPlan[]  @relation("MedPlanSlot")
  checklistAsMed           MedChecklist[]        @relation("MedChecklistMed")
  checklistAsSlot          MedChecklist[]        @relation("MedChecklistSlot")
  documents                ParticipantDocument[] @relation("ParticipantDocumentType")
  planBlocksAsLeader       PlanBlock[]           @relation("PlanBlockLeader")
  planBlocksAsLocation     PlanBlock[]           @relation("PlanBlockLocation")
  planActivitiesAsLeader   PlanActivity[]        @relation("PlanActivityLeader")
  planActivitiesAsLocation PlanActivity[]        @relation("PlanActivityLocation")

  @@map("event_list_items")
}

model ParticipantMedPlan {
  id            String  @id @default(uuid())
  participantId String  @map("participant_id")
  eventMedId    String  @map("event_med_id")
  eventSlotId   String  @map("event_slot_id")
  dose          String?
  notes         String?
  active        Boolean @default(true)

  participant Participant   @relation(fields: [participantId], references: [id])
  eventMed    EventListItem @relation("MedPlanMed", fields: [eventMedId], references: [id])
  eventSlot   EventListItem @relation("MedPlanSlot", fields: [eventSlotId], references: [id])

