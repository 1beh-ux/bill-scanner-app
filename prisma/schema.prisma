generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  accountant
  user
}

enum EventStatus {
  active
  closed
}

// pending: just entered the roster (manually, pasted, or imported from a
// registration Sheet) and hasn't been reviewed yet. accepted: an admin
// decided to accept them and (normally) sent the acceptance email -- see
// REGISTRATION_ACCEPTANCE_PURPOSE_KEY. No "rejected" state yet -- not asked
// for, add one if that's ever a real need.
enum RegistrationStatus {
  pending
  accepted
}

enum IngestChannel {
  drive
  upload
  camera
}

enum BillStatus {
  new
  queued
  processing
  auto_approved
  to_review
  failed
  approved
}

enum Currency {
  CZK
  PLN
  EUR
}

enum AuditActionType {
  edit
  approve
  reopen
}

enum ModuleKey {
  bills
  health
  mail
}

enum IncidentCategory {
  illness
  injury
  parasite
  medication
  other
}

enum BodyView {
  front
  back
}

enum IncidentUpdateType {
  correct
  void
}

enum ListTemplateKind {
  med
  slot
  situation
  document
}

enum ParentEmailStatus {
  sent
  failed
}

enum MailDocReceivedVia {
  email
  manual
  // System-generated (the registration-document merge on acceptance send,
  // see src/lib/document-merge.ts + src/lib/participant-document-store.ts)
  // rather than something a guardian sent in.
  generated
}

enum MailActionType {
  bulk_move
  bulk_delete
  attachment_saved
}

enum MailActionStatus {
  ok
  error
}

enum UserLang {
  cs
  en
}

enum UserTheme {
  light
  dark
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  role        UserRole
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  // Personal preferences (src/app/api/me/route.ts, src/lib/i18n.tsx) --
  // localStorage still seeds the instant paint before this loads, then
  // reconciles to these once /api/me resolves.
  preferredLang   UserLang  @default(cs) @map("preferred_lang")
  preferredTheme  UserTheme @default(light) @map("preferred_theme")
  landingPath     String?   @map("landing_path")
  // Overrides {{sender_name}} in outgoing emails (src/lib/parent-email-send.ts,
  // src/lib/mail-bulk-status-send.ts, src/lib/participant-bulk-email.ts) --
  // an Outlook-signature-style personal setting, falling back to
  // displayName when unset.
  emailSignature  String?   @map("email_signature")
  // Second settings layer: modules a person has chosen to hide from their own
  // sidebar. Admin decides what they *have* (UserEventModuleAccess); this only
  // narrows their own view, never grants anything.
  hiddenModules   ModuleKey[] @default([]) @map("hidden_modules")

  moduleAccess       UserEventModuleAccess[]
  driveAccount           DriveAccount?     @relation("DriveAccountConnectedBy")
  eventsDriveConfigured  Event[]           @relation("EventDriveConfiguredBy")
  authorBankAudits       AuthorBankAudit[] @relation("AuthorBankAuditChangedBy")
  billsCreated       Bill[]           @relation("BillCreatedBy")
  billsApproved      Bill[]           @relation("BillApprovedBy")
  billsPaid          Bill[]           @relation("BillPaidBy")
  auditLogEntries    BillAuditLog[]
  incidentsCreated   Incident[]       @relation("IncidentCreatedBy")
  incidentUpdates    IncidentUpdate[] @relation("IncidentUpdatedBy")
  medChecklistGiven  MedChecklist[]   @relation("MedChecklistGivenBy")
  parentEmailsSent   ParentEmailLog[] @relation("ParentEmailSentBy")
  mailAccountsConnected MailSenderAccount[] @relation("MailAccountConnectedBy")
  documentsReceived    ParticipantDocument[] @relation("ParticipantDocumentReceivedBy")
  mailActionsPerformed MailActionLog[]       @relation("MailActionLogUser")

  @@map("users")
}

model Module {
  key  ModuleKey @id
  name String

  @@map("modules")
}

model EventModule {
  eventId   String    @map("event_id")
  moduleKey ModuleKey @map("module_key")
  enabled   Boolean   @default(false)

  event Event @relation(fields: [eventId], references: [id])

  @@id([eventId, moduleKey])
  @@map("event_modules")
}

model UserEventModuleAccess {
  userId    String    @map("user_id")
  eventId   String    @map("event_id")
  moduleKey ModuleKey @map("module_key")

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@id([userId, eventId, moduleKey])
  @@map("user_event_module_access")
}

model Event {
  id                  String      @id @default(uuid())
  name                String
  startDate           DateTime    @map("start_date") @db.Date
  endDate             DateTime    @map("end_date") @db.Date
  status              EventStatus @default(active)
  driveIngestFolderId String?     @map("drive_ingest_folder_id")
  driveExportFolderId String?     @map("drive_export_folder_id")
  driveManifestSpreadsheetId String? @map("drive_manifest_spreadsheet_id")
  // Where per-participant folders (registration documents, received/generated
  // files) live -- separate from the bills export folder above. Null falls
  // back to driveExportFolderId (the old shared behavior).
  driveParticipantsFolderId String? @map("drive_participants_folder_id")
  // The user whose connected Google account does this event's Drive work (see
  // DriveAccount). Set when someone saves the event's Drive folders, when a user
  // connects from the Drive tab and none is set, or via "take over".
  driveConfiguredByUserId String? @map("drive_configured_by_user_id")
  senderEmail         String?     @map("sender_email")
  driveDocSyncEnabled      Boolean   @default(true) @map("drive_doc_sync_enabled")
  statusExportEnabled      Boolean   @default(true) @map("status_export_enabled")
  statusExportSheetId      String?   @map("status_export_sheet_id")
  statusExportLastSyncedAt DateTime? @map("status_export_last_synced_at")
  mailDoneLabelName        String?   @map("mail_done_label_name")
  mailQuestionnaireUrl     String?   @map("mail_questionnaire_url")
  // Persisted registration-sheet connection (Seznam účastníků import
  // settings) -- set once, reused on every future import instead of
  // re-pasting the sheet id and remapping columns each time. Mapping is
  // stored keyed by header name (not column index), since sheet columns can
  // be reordered between imports; unrecognized headers fall back to the
  // same guess-from-header-text heuristic as before.
  participantsSheetId      String?   @map("participants_sheet_id")
  participantsColumnMapping Json?    @map("participants_column_mapping")
  // Camp-fee collection, used by the registration-document merge (price +
  // QR payment code) -- deliberately separate from any bill/reimbursement
  // bank account elsewhere in the app; this is the org's own fee account.
  memberPriceCzk               Int?    @map("member_price_czk")
  nonMemberPriceCzk             Int?    @map("non_member_price_czk")
  registrationBankAccountNumber String? @map("registration_bank_account_number")
  registrationBankCode          String? @map("registration_bank_code")
  // Variable-symbol formula config (computed field, see
  // src/lib/document-variables.ts's buildVariableSymbol): year comes from
  // startDate, vsEventType/vsOrderInYear are admin-typed single digits,
  // vsMembershipFieldKey names the boolean custom field whose "true" value
  // sets the membership digit to 1 (else 0). Null vsMembershipFieldKey means
  // no membership digit is configured -- always 0.
  vsEventType          Int?     @map("vs_event_type")
  vsOrderInYear        Int?     @map("vs_order_in_year")
  vsMembershipFieldKey String?  @map("vs_membership_field_key")
  // Side length (mm) of the payment QR image inserted into documents. Null
  // means the default (DEFAULT_QR_SIZE_MM in src/lib/document-variables.ts).
  qrSizeMm             Int?     @map("qr_size_mm")
  // Ordered EventParticipantField keys chosen for the central roster's
  // columns (Name is always first and isn't included here). Null means not
  // configured yet -- falls back to every active field with the `list`
  // surface, in API order (the old, always-on behavior).
  participantsListColumns Json? @map("participants_list_columns")
  // Ordered column keys chosen for the bills list (src/lib/bill-columns.ts). Stored per
  // event, so everyone with access sees the same columns; null = the default set.
  // (A Json array like participantsListColumns -- Prisma has no nullable scalar list.)
  billsListColumns Json? @map("bills_list_columns")
  createdAt           DateTime    @default(now()) @map("created_at")
  closedAt            DateTime?   @map("closed_at")

  categories          EventCategory[]
  modules              EventModule[]
  moduleAccess          UserEventModuleAccess[]
  authorAccess         AuthorEventAccess[]
  authorBankAudits     AuthorBankAudit[]
  driveConfiguredBy    User?    @relation("EventDriveConfiguredBy", fields: [driveConfiguredByUserId], references: [id])
  bills                Bill[]
  participants         Participant[]
  eventListItems       EventListItem[]
  eventEmailTemplates  EventEmailTemplate[]
  mailActionLogs       MailActionLog[]
  eventParticipantFields EventParticipantField[]

  @@map("events")
}

model CategoryTemplate {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  @@map("category_templates")
}

model EventCategory {
  id             String  @id @default(uuid())
  eventId        String  @map("event_id")
  name           String
  description    String?
  budgetAmount   Decimal @map("budget_amount") @db.Decimal(12, 2)
  isFromTemplate Boolean @default(false) @map("is_from_template")

  event          Event          @relation(fields: [eventId], references: [id])
  billCategories BillCategory[]

  @@map("event_categories")
}

model Author {
  id                 String   @id @default(uuid())
  canonicalName      String   @map("canonical_name")
  bankAccountNumber  String?  @map("bank_account_number")
  bankCode           String?  @map("bank_code")
  mergedIntoAuthorId String?  @map("merged_into_author_id")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")

  mergedInto  Author?             @relation("AuthorMerge", fields: [mergedIntoAuthorId], references: [id])
  mergedFrom  Author[]            @relation("AuthorMerge")
  eventAccess AuthorEventAccess[]
  bills       Bill[]
  bankAudits  AuthorBankAudit[]

  @@map("authors")
}

enum AuthorBankAuditSource {
  event_edit
  admin_edit
  merge
  create
  import
}

// Every change of a payer's bank account/code (who, when, old -> new, and
// which event it was made from). Written in the same transaction as the change.
model AuthorBankAudit {
  id                     String                  @id @default(uuid())
  authorId               String                  @map("author_id")
  changedByUserId        String                  @map("changed_by_user_id")
  eventId                String?                 @map("event_id")
  oldBankAccountNumber   String?                 @map("old_bank_account_number")
  oldBankCode            String?                 @map("old_bank_code")
  newBankAccountNumber   String?                 @map("new_bank_account_number")
  newBankCode            String?                 @map("new_bank_code")
  source                 AuthorBankAuditSource
  createdAt              DateTime                @default(now()) @map("created_at")

  author        Author @relation(fields: [authorId], references: [id])
  changedByUser User   @relation("AuthorBankAuditChangedBy", fields: [changedByUserId], references: [id])
  event         Event? @relation(fields: [eventId], references: [id])

  @@index([authorId, createdAt])
  @@map("author_bank_audit")
}

model AuthorEventAccess {
  authorId String @map("author_id")
  eventId  String @map("event_id")

  author Author @relation(fields: [authorId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])

  @@id([authorId, eventId])
  @@map("author_event_access")
}

model Translation {
  key String @id
  cs  String
  en  String

  @@map("translations")
}

model Bill {
  id                String        @id @default(uuid())
  eventId           String        @map("event_id")
  gcsObjectPath     String        @map("gcs_object_path")
  originalGcsObjectPath String?   @map("original_gcs_object_path")
  originalFilename  String        @map("original_filename")
  displayFilename   String?       @map("display_filename")
  driveSourceFileId String?       @map("drive_source_file_id")
  contentHash       String        @map("content_hash")
  ingestChannel     IngestChannel @map("ingest_channel")
  merchantName      String?       @map("merchant_name")
  billDate          DateTime?     @map("bill_date") @db.Date
  totalAmount       Decimal?      @map("total_amount") @db.Decimal(12, 2)
  currency          Currency      @default(CZK)
  amountCzk         Decimal?      @map("amount_czk") @db.Decimal(12, 2)
  exchangeRateUsed  Decimal?      @map("exchange_rate_used") @db.Decimal(12, 6)
  exchangeRateDate  DateTime?     @map("exchange_rate_date") @db.Date
  payerAuthorId     String?       @map("payer_author_id")
  pendingCategoryId String?  @map("pending_category_id")
  paidToAuthor      Boolean       @default(false) @map("paid_to_author")
  paidAt            DateTime?     @map("paid_at")
  paidByUserId      String?       @map("paid_by_user_id")
  status            BillStatus    @default(new)
  notes             String?
  aiConfidence      Decimal?      @map("ai_confidence") @db.Decimal(5, 4)
  aiRawResponse     Json?         @map("ai_raw_response")
  createdByUserId   String        @map("created_by_user_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at")
  approvedAt        DateTime?     @map("approved_at")
  approvedByUserId  String?       @map("approved_by_user_id")
  exportedAt        DateTime?     @map("exported_at")
  exportFilename    String?       @map("export_filename")

  event       Event          @relation(fields: [eventId], references: [id])
  payerAuthor Author?        @relation(fields: [payerAuthorId], references: [id])
  createdBy   User           @relation("BillCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy  User?          @relation("BillApprovedBy", fields: [approvedByUserId], references: [id])
  paidBy      User?          @relation("BillPaidBy", fields: [paidByUserId], references: [id])
  categories  BillCategory[]
  auditLog    BillAuditLog[]

  @@unique([eventId, contentHash], name: "bills_event_content_hash_unique")
  @@map("bills")
}

model BillCategory {
  id              String   @id @default(uuid())
  billId          String   @map("bill_id")
  eventCategoryId String   @map("event_category_id")
  amount          Decimal  @db.Decimal(12, 2)
  amountCzk       Decimal? @map("amount_czk") @db.Decimal(12, 2)

  bill          Bill          @relation(fields: [billId], references: [id])
  eventCategory EventCategory @relation(fields: [eventCategoryId], references: [id])

  @@map("bill_categories")
}

model BillAuditLog {
  id         String          @id @default(uuid())
  billId     String          @map("bill_id")
  userId     String          @map("user_id")
  actionType AuditActionType @map("action_type")
  fieldName  String?         @map("field_name")
  oldValue   String?         @map("old_value")
  newValue   String?         @map("new_value")
  changedAt  DateTime        @default(now()) @map("changed_at")

  bill Bill @relation(fields: [billId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("bill_audit_log")
}

model ExchangeRate {
  id        String   @id @default(uuid())
  currency  Currency
  rateDate  DateTime @map("rate_date") @db.Date
  rateToCzk Decimal  @map("rate_to_czk") @db.Decimal(16, 6)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([currency, rateDate])
  @@map("exchange_rates")
}

model MerchantAlias {
  id            String   @id @default(uuid())
  rawText       String   @unique @map("raw_text")
  canonicalName String   @map("canonical_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("merchant_aliases")
}

// ---------------------------------------------------------------------------
// Health module
// ---------------------------------------------------------------------------

model Participant {
  id            String    @id @default(uuid())
  eventId       String    @map("event_id")
  // `name` is kept as the maintained full display name ("Jméno Příjmení",
  // written from firstName+lastName on every save) so existing readers
  // (search, sort, exports, {{Name}}) keep working unchanged -- see
  // src/lib/participant-name.ts. firstName/lastName are null for rows not
  // yet migrated (scripts/split-participant-names.ts) or left ambiguous.
  name          String
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  groupName     String?   @map("group_name")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  active        Boolean   @default(true)
  registrationStatus RegistrationStatus @default(pending) @map("registration_status")
  // Admin-defined participant fields (address, health insurance, camp-fee
  // membership, etc.) -- Record<fieldKey, string>, keyed by
  // EventParticipantField.key. Not a fixed set of columns: which fields
  // exist, their type, and which screens show them are all admin-editable
  // (see ParticipantFieldTemplate/EventParticipantField below and
  // src/lib/document-variables.ts's participant_custom_field resolver).
  customFieldValues Json?     @map("custom_field_values")
  // Camp-fee variable symbol -- assigned once, at acceptance (see
  // src/lib/document-variables.ts), stable afterwards. Null until accepted.
  registrationNumber Int?     @map("registration_number")
  createdAt     DateTime  @default(now()) @map("created_at")

  event        Event                 @relation(fields: [eventId], references: [id])
  guardians    ParticipantGuardian[]
  incidents    Incident[]
  medPlans     ParticipantMedPlan[]
  medChecklist MedChecklist[]
  emailLogs    ParentEmailLog[]
  documents    ParticipantDocument[]
  mailActionLogs MailActionLog[]

  @@unique([eventId, registrationNumber])
  @@map("participants")
}

model ParticipantGuardian {
  id                     String  @id @default(uuid())
  participantId          String  @map("participant_id")
  name                   String?
  email                  String
  relationship           String?
  phone                  String?
  receivesCommunications Boolean @default(true) @map("receives_communications")

  participant Participant      @relation(fields: [participantId], references: [id])
  emailLogs   ParentEmailLog[]

  @@map("participant_guardians")
}

enum ParticipantFieldType {
  text
  number
  date
  boolean
  select
  image
}

// Deliberately distinct from ModuleKey -- "list" (the central Seznam
// účastníků roster) isn't an access-controlled module, it's a display
// surface within the roster. A genuinely new module gets a new surface
// value here the same way ModuleKey itself grows when a module ships.
// `documents` and `import` were folded in from the old standalone
// MergeVariable/"Include in documents" mechanism and the participant-import
// screen's hardcoded target list -- both are now just more surfaces a field
// can be flagged for, same UI as the display surfaces. They're a11y-neutral
// to module gating (see allowedParticipantFieldKeys) since a field can be
// document-mergeable regardless of which module it's otherwise scoped to.
enum ParticipantFieldSurface {
  list          // Seznam účastníků (central roster) columns
  health_list   // Zdraví page columns
  health_detail // Zdraví participant detail page fields
  mail_list     // Mail participants page columns
  documents     // usable as {{key}} in document/mail merge
  import        // offered as a target column when importing participants
}

// Which participant-connected thing a field actually is. `custom` is the
// only kind ParticipantFieldTemplate ever holds (org-wide admin-defined
// fields); `builtin`/`guardian`/`computed` only ever exist as fixed,
// non-deletable EventParticipantField rows seeded per event (see
// src/lib/participant-field-seed.ts's seedFixedParticipantFields) so their
// surfaces are configurable from the same admin screen as custom fields,
// without a template layer that makes no sense for a field type can't add
// or remove.
enum ParticipantFieldKind {
  custom
  builtin
  guardian
  computed
}

// Only set when kind = computed -- which fixed formula resolves the value.
// A new computed type needs a code change in src/lib/document-variables.ts
// regardless (the formula itself can't be admin-authored), this just says
// which one a given fixed row maps to.
enum ComputedFieldType {
  effective_price
  variable_symbol
  payment_qr_image
  // First guardian with receivesCommunications = true, else the first
  // guardian -- see resolveContactEmail() in document-variables.ts.
  contact_email
}

// Org-wide field definition, synced into EventParticipantField the same
// way CategoryTemplate syncs into EventCategory (see
// src/app/api/events/[id]/participant-fields/sync/route.ts). `key` is the
// stable {{key}} used both in customFieldValues and, once its `documents`
// surface is on, in document templates -- immutable after creation.
model ParticipantFieldTemplate {
  key             String                    @id
  label           String
  fieldType       ParticipantFieldType      @map("field_type")
  options         Json?
  // Suggested surfaces applied when this template is synced into an event
  // (manually, at event creation, or when a module the surfaces belong to
  // gets enabled -- see .../participant-fields/sync/route.ts and the
  // modules PATCH route's enable hook).
  defaultSurfaces ParticipantFieldSurface[] @map("default_surfaces")
  active          Boolean                   @default(true)

  @@map("participant_field_templates")
}

model EventParticipantField {
  id             String                    @id @default(uuid())
  eventId        String                    @map("event_id")
  key            String
  label          String
  fieldType      ParticipantFieldType      @map("field_type")
  options        Json?
  surfaces       ParticipantFieldSurface[]
  sortOrder      Int?                      @map("sort_order")
  active         Boolean                   @default(true)
  isFromTemplate Boolean                   @default(false) @map("is_from_template")
  // custom rows (the default) are fully admin-managed, same as before.
  // builtin/guardian/computed rows are fixed system rows seeded per event --
  // their key/fieldType/kind/computedType aren't editable, only surfaces/active.
  kind           ParticipantFieldKind      @default(custom)
  computedType   ComputedFieldType?        @map("computed_type")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, key])
  @@map("event_participant_fields")
}

model Incident {
  id               String           @id @default(uuid())
  participantId    String           @map("participant_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  createdByUserId  String           @map("created_by_user_id")
  category         IncidentCategory
  templateType     String?          @map("template_type")
  incidentDate     DateTime         @default(now()) @map("incident_date") @db.Date
  incidentTime     String?          @map("incident_time")
  actionSummary    String           @map("action_summary")
  pillName         String?          @map("pill_name")
  details          String?
  photoGcsPath     String?          @map("photo_gcs_path")
  parentIncidentId String?          @map("parent_incident_id")
  tempC            Decimal?         @map("temp_c") @db.Decimal(4, 1)
  bodyView         BodyView?        @map("body_view")
  bodyXPct         Decimal?         @map("body_x_pct") @db.Decimal(5, 2)
  bodyYPct         Decimal?         @map("body_y_pct") @db.Decimal(5, 2)

  participant    Participant      @relation(fields: [participantId], references: [id])
  createdBy      User             @relation("IncidentCreatedBy", fields: [createdByUserId], references: [id])
  parentIncident Incident?        @relation("IncidentFollowUp", fields: [parentIncidentId], references: [id])
  followUps      Incident[]       @relation("IncidentFollowUp")
  updates        IncidentUpdate[]

  @@map("incidents")
}

model IncidentUpdate {
  id              String              @id @default(uuid())
  incidentId      String              @map("incident_id")
  updatedAt       DateTime            @default(now()) @map("updated_at")
  updatedByUserId String              @map("updated_by_user_id")
  updateType      IncidentUpdateType  @map("update_type")
  incidentDate    DateTime            @map("incident_date") @db.Date
  incidentTime    String?             @map("incident_time")
  actionSummary   String              @map("action_summary")
  pillName        String?             @map("pill_name")
  details         String?
  photoGcsPath    String?             @map("photo_gcs_path")
  tempC           Decimal?            @map("temp_c") @db.Decimal(4, 1)
  bodyView        BodyView?           @map("body_view")
  bodyXPct        Decimal?            @map("body_x_pct") @db.Decimal(5, 2)
  bodyYPct        Decimal?            @map("body_y_pct") @db.Decimal(5, 2)
  note            String?

  incident  Incident @relation(fields: [incidentId], references: [id])
  updatedBy User     @relation("IncidentUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("incident_updates")
}

// Generic org-default -> per-event-copy template mechanism, shared by meds,
// meds time slots, and situation templates (see design doc "Build note").
model ListTemplate {
  id        String           @id @default(uuid())
  kind      ListTemplateKind
  key       String?
  name      String
  sortOrder Int?             @map("sort_order")
  active    Boolean          @default(true)
  data      Json?

  @@map("list_templates")
}

model EventListItem {
  id             String           @id @default(uuid())
  eventId        String           @map("event_id")
  kind           ListTemplateKind
  key            String?
  name           String
  sortOrder      Int?             @map("sort_order")
  active         Boolean          @default(true)
  isFromTemplate Boolean          @default(false) @map("is_from_template")
  data           Json?

  event            Event                @relation(fields: [eventId], references: [id])
  medPlansAsMed    ParticipantMedPlan[] @relation("MedPlanMed")
  medPlansAsSlot   ParticipantMedPlan[] @relation("MedPlanSlot")
  checklistAsMed   MedChecklist[]       @relation("MedChecklistMed")
  checklistAsSlot  MedChecklist[]       @relation("MedChecklistSlot")
  documents        ParticipantDocument[] @relation("ParticipantDocumentType")

  @@map("event_list_items")
}

model ParticipantMedPlan {
  id            String  @id @default(uuid())
  participantId String  @map("participant_id")
  eventMedId    String  @map("event_med_id")
  eventSlotId   String  @map("event_slot_id")
  dose          String?
  notes         String?
  active        Boolean @default(true)

  participant Participant   @relation(fields: [participantId], references: [id])
  eventMed    EventListItem @relation("MedPlanMed", fields: [eventMedId], references: [id])
  eventSlot   EventListItem @relation("MedPlanSlot", fields: [eventSlotId], references: [id])

  @@map("participant_med_plans")
}

model MedChecklist {
  id            String    @id @default(uuid())
  participantId String    @map("participant_id")
  eventMedId    String    @map("event_med_id")
  eventSlotId   String    @map("event_slot_id")
  date          DateTime  @db.Date
  given         Boolean   @default(false)
  givenAt       DateTime? @map("given_at")
  givenByUserId String?   @map("given_by_user_id")

  participant Participant   @relation(fields: [participantId], references: [id])
  eventMed    EventListItem @relation("MedChecklistMed", fields: [eventMedId], references: [id])
  eventSlot   EventListItem @relation("MedChecklistSlot", fields: [eventSlotId], references: [id])
  givenBy     User?         @relation("MedChecklistGivenBy", fields: [givenByUserId], references: [id])

  @@unique([participantId, eventMedId, eventSlotId, date])
  @@map("med_checklist")
}

model EmailTemplate {
  id         String  @id @default(uuid())
  purposeKey String  @unique @map("purpose_key")
  subject    String
  body       String
  active     Boolean @default(true)

  @@map("email_templates")
}

model EventEmailTemplate {
  id             String  @id @default(uuid())
  eventId        String  @map("event_id")
  purposeKey     String  @map("purpose_key")
  subject        String
  body           String
  isFromTemplate Boolean @default(false) @map("is_from_template")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, purposeKey])
  @@map("event_email_templates")
}

// A Workspace mailbox that its own owner has connected via OAuth consent
// (gmail.send scope only) -- the fallback to domain-wide delegation, which
// was rejected by the Workspace admin. Keyed by email, not event, so the
// same connected mailbox can be reused across multiple events without
// reconnecting; Event.senderEmail just points at one of these by address.
model MailSenderAccount {
  id                  String   @id @default(uuid())
  email               String   @unique
  refreshTokenEncrypted String @map("refresh_token_encrypted")
  scope               String?  @map("scope")
  connectedByUserId   String   @map("connected_by_user_id")
  connectedAt         DateTime @default(now()) @map("connected_at")

  connectedByUser User @relation("MailAccountConnectedBy", fields: [connectedByUserId], references: [id])

  @@map("mail_sender_accounts")
}

// A user's own connected Google account (OAuth). Each user can have at most one
// (unique connected_by_user_id -- reconnecting replaces their own row, never
// someone else's). An event uses the account of the user who configured its
// Drive (Event.driveConfiguredByUserId) for ALL Drive/Sheets/Docs work, including
// background jobs; without a valid connection it falls back to the service
// account (src/lib/drive.ts getDriveIdentity). `tokenInvalidAt` is set when
// Google reports the refresh token dead (revoked/expired) and cleared on reconnect.
model DriveAccount {
  id                    String    @id @default(uuid())
  email                 String    @unique
  refreshTokenEncrypted String    @map("refresh_token_encrypted")
  scope                 String?
  connectedByUserId     String    @unique @map("connected_by_user_id")
  connectedAt           DateTime  @default(now()) @map("connected_at")
  tokenInvalidAt        DateTime? @map("token_invalid_at")

  connectedByUser User @relation("DriveAccountConnectedBy", fields: [connectedByUserId], references: [id])

  @@map("drive_accounts")
}

model ParentEmailLog {
  id            String             @id @default(uuid())
  participantId String             @map("participant_id")
  guardianId    String             @map("guardian_id")
  purposeKey    String             @map("purpose_key")
  sentAt        DateTime           @default(now()) @map("sent_at")
  status        ParentEmailStatus
  errorMessage  String?            @map("error_message")
  sentByUserId  String             @map("sent_by_user_id")
  pdfGcsPath    String?            @map("pdf_gcs_path")

  participant Participant         @relation(fields: [participantId], references: [id])
  guardian    ParticipantGuardian @relation(fields: [guardianId], references: [id])
  sentBy      User                @relation("ParentEmailSentBy", fields: [sentByUserId], references: [id])

  @@map("parent_email_log")
}

// The received-document record for Mail Helper. Row existence = received;
// no row = missing. GCS is the source of truth; drive_file_id/drive_synced_at
// are set once the one-way nightly/on-demand mirror sync runs (see design doc).
model ParticipantDocument {
  id                   String             @id @default(uuid())
  participantId        String             @map("participant_id")
  eventListItemId      String             @map("event_list_item_id")
  gcsPath              String?            @map("gcs_path")
  contentHash          String?            @map("content_hash")
  originalFilename     String?            @map("original_filename")
  driveFileId          String?            @map("drive_file_id")
  driveSyncedAt        DateTime?          @map("drive_synced_at")
  receivedVia          MailDocReceivedVia @map("received_via")
  sourceEmailMessageId String?            @map("source_email_message_id")
  receivedAt           DateTime           @default(now()) @map("received_at")
  receivedByUserId     String             @map("received_by_user_id")

  participant     Participant   @relation(fields: [participantId], references: [id])
  eventListItem   EventListItem @relation("ParticipantDocumentType", fields: [eventListItemId], references: [id])
  receivedByUser  User          @relation("ParticipantDocumentReceivedBy", fields: [receivedByUserId], references: [id])

  @@map("participant_documents")
}

// Everything Mail Helper does that isn't a sent email (which stays in
// ParentEmailLog with its own purpose keys) -- bulk move/delete, attachment
// saves. See design doc "Logging -- split across two tables, not one".
model MailActionLog {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  eventId       String            @map("event_id")
  action        MailActionType
  messageId     String?           @map("message_id")
  participantId String?           @map("participant_id")
  subject       String?
  status        MailActionStatus
  details       String?
  createdAt     DateTime          @default(now()) @map("created_at")

  user        User         @relation("MailActionLogUser", fields: [userId], references: [id])
  event       Event        @relation(fields: [eventId], references: [id])
  participant Participant? @relation(fields: [participantId], references: [id])

  @@map("mail_action_logs")
}
